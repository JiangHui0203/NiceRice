.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8fafc;
  box-sizing: border-box;
}

/* 1. Header Card */
.detail-header-card {
  padding: 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

.detail-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-main-title {
  font-size: 38rpx;
  font-weight: 850;
  color: #1e293b;
}

.detail-time-badge {
  font-size: 24rpx;
  font-weight: 800;
  color: #0d9488;
  background: rgba(13, 148, 136, 0.06);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(13, 148, 136, 0.1);
}

.detail-summary-text {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 700;
}

.highlight-count {
  color: #0d9488;
  font-weight: 850;
}

.content-scroll {
  flex: 1;
  box-sizing: border-box;
  padding: 24rpx;
}

/* Cards & Section headers */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.01);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 850;
  color: #334155;
  border-left: 6rpx solid #0d9488;
  padding-left: 12rpx;
}

.section-action {
  font-size: 24rpx;
  color: #ff3b30;
  font-weight: 700;
}

/* Friend checklist styles */
.details-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.detail-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.detail-friend-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-indicator {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
}

.status-indicator.available {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}

.status-indicator.busy {
  background: rgba(239, 68, 68, 0.06);
  color: #ef4444;
}

.detail-friend-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #1e293b;
}

.detail-friend-desc {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 700;
}

/* Voting widget styles */
.empty-votes-card {
  padding: 44rpx 24rpx;
  text-align: center;
  border: 1rpx dashed rgba(13, 148, 136, 0.25);
  box-shadow: none;
  background: #ffffff;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 24rpx;
  font-weight: 850;
  color: #334155;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 700;
}

.btn-primary {
  background-color: #0d9488;
  color: #ffffff;
  border-radius: 16rpx;
  font-weight: bold;
}

.votes-card {
  padding: 28rpx;
}

.vote-options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.vote-option-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  transition: all 0.2s ease;
  position: relative;
}

.vote-checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5e1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.vote-checkbox.checked {
  background-color: #0d9488;
  border-color: #0d9488;
}

.vote-checkbox.checked::after {
  content: "✓";
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
}

.vote-option-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.vote-option-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vote-option-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #1e293b;
}

.vote-count-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #0d9488;
}

.vote-progress-bg {
  height: 10rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  overflow: hidden;
  position: relative;
}

.vote-progress-fill {
  height: 100%;
  background: linear-gradient(to right, #0d9488, #14b8a6);
  border-radius: 6rpx;
  transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.vote-voters {
  font-size: 18rpx;
  color: #64748b;
  font-weight: 700;
  margin-top: 2rpx;
}

.vote-option-delete {
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  color: #cbd5e1;
  font-weight: bold;
  flex-shrink: 0;
  transition: color 0.2s ease;
}

.vote-option-delete:active {
  color: #ef4444;
}

.vote-add-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.vote-input {
  flex: 1;
  height: 72rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
  box-sizing: border-box;
}

.vote-add-btn {
  width: 130rpx !important;
  height: 72rpx;
  background: rgba(13, 148, 136, 0.06);
  color: #0d9488;
  border: 1rpx solid rgba(13, 148, 136, 0.15);
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 16rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Coupon list styles */
.coupon-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.coupon-left {
  flex: 1;
  margin-right: 16rpx;
  min-width: 0;
}

.coupon-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.coupon-badge {
  font-size: 16rpx;
  font-weight: 800;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.coupon-badge.urgent {
  background: rgba(239, 68, 68, 0.08);
  color: #ef4444;
}

.coupon-badge.priority {
  background: rgba(245, 158, 11, 0.08);
  color: #f59e0b;
}

.coupon-badge.normal {
  background: rgba(13, 148, 136, 0.08);
  color: #0d9488;
}

.coupon-title {
  font-size: 26rpx;
  font-weight: 850;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-merchant {
  font-size: 20rpx;
  color: #475569;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.coupon-expiry {
  font-size: 18rpx;
  color: #64748b;
  font-weight: 700;
}

.coupon-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coupon-price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price-val {
  font-size: 26rpx;
  font-weight: 850;
  color: #0d9488;
}

.price-original {
  font-size: 18rpx;
  color: #94a3b8;
  text-decoration: line-through;
  font-weight: 700;
}

.btn-create-plan {
  height: 60rpx;
  line-height: 58rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 30rpx;
  padding: 0 24rpx;
  min-height: 0 !important;
  margin: 0;
  box-shadow: 0 4rpx 10rpx rgba(13, 148, 136, 0.15);
}

.empty-coupons-card {
  padding: 44rpx 24rpx;
  text-align: center;
}

/* 5. Bottom floating action bar */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 24rpx;
  background: #ffffff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  z-index: 10;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-finalize {
  width: 100% !important;
  height: 84rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 850;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(13, 148, 136, 0.25);
  margin: 0;
  border: none;
}

/* 6. Half-screen Drawer Styles */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.drawer-mask.show {
  visibility: visible;
  opacity: 1;
}

.drawer-container {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  box-sizing: border-box;
  padding: 36rpx 44rpx calc(48rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.drawer-mask.show .drawer-container {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.drawer-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #1e293b;
}

.drawer-close {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 800;
}

/* Export specific styles */
.export-preview-card {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.preview-item {
  display: flex;
  margin-bottom: 10rpx;
}

.preview-item:last-child {
  margin-bottom: 0;
}

.preview-label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 800;
  width: 100rpx;
  flex-shrink: 0;
}

.preview-val {
  font-size: 22rpx;
  color: #334155;
  font-weight: 800;
}

.export-checkboxes-title {
  font-size: 22rpx;
  font-weight: 850;
  color: #64748b;
  margin-bottom: 16rpx;
  text-transform: uppercase;
}

.export-checkbox-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.export-checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.export-checkbox-box {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  border: 2rpx solid #cbd5e1;
  flex-shrink: 0;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.export-checkbox-box.checked {
  background-color: #0d9488;
  border-color: #0d9488;
}

.export-checkbox-box.checked::after {
  content: "✓";
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
}

.export-checkbox-label {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.export-check-name {
  font-size: 24rpx;
  font-weight: 850;
  color: #1e293b;
}

.export-check-desc {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 700;
}

.drawer-footer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.drawer-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
}

.drawer-btn-secondary {
  background: rgba(13, 148, 136, 0.06);
  color: #0d9488;
  border: 1rpx solid rgba(13, 148, 136, 0.15);
  font-weight: 850;
}

.drawer-btn-primary {
  background: #0d9488;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(13, 148, 136, 0.2);
  font-weight: 850;
}

/* ===== Meal Planning and Notes ===== */
.meal-plan-card {
  padding: 24rpx;
}

.meal-dishes-section {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed rgba(0, 0, 0, 0.06);
}

.meal-dishes-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #475569;
  margin-bottom: 10rpx;
}

.meal-dishes-content {
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 600;
  line-height: 1.6;
  white-space: pre-wrap;
  background: rgba(13, 148, 136, 0.04);
  padding: 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(13, 148, 136, 0.08);
}

.meal-note-section {
  margin-bottom: 20rpx;
}

.meal-note-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #475569;
  margin-bottom: 10rpx;
}

.meal-note-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 600;
  line-height: 1.6;
  padding: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.meal-pills-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meal-pills-label {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 700;
  flex-shrink: 0;
}

.meal-pills-scroll {
  flex: 1;
  white-space: nowrap;
}

.meal-pill {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: rgba(13, 148, 136, 0.06);
  color: #0d9488;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 20rpx;
  border: 1rpx solid rgba(13, 148, 136, 0.12);
  margin-right: 10rpx;
}

.meal-pill:active {
  background: rgba(13, 148, 136, 0.15);
}
