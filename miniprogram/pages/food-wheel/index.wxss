.wheel-page {
  padding-bottom: 80rpx;
}

.wheel-hero {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(244, 248, 246, 0.9) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
  padding: 36rpx 28rpx;
  border-radius: var(--radius-lg);
}

.wheel-container {
  height: 620rpx;
  margin: 14rpx auto 30rpx;
  position: relative;
  width: 620rpx;
}

.wheel-disk {
  border-radius: 50%;
  box-sizing: border-box;
  height: 620rpx;
  width: 620rpx;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  overflow: hidden;
  background-color: #ffffff;
}

.wheel-static-bezel {
  position: absolute;
  left: 0;
  top: 0;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  border: 12rpx solid #e5cda6; /* Static luxury gold rim */
  box-shadow: 0 32rpx 80rpx rgba(44, 62, 53, 0.16), 0 4rpx 12rpx rgba(0, 0, 0, 0.05),
              inset 0 4rpx 8rpx rgba(255, 255, 255, 0.6), inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.12); /* Static 3D drop shadow & inner highlights */
  box-sizing: border-box;
  z-index: 4; /* Overlay on top of the rotating wheel-disk (z-index 1) but below the center bezel and pointer */
  pointer-events: none; /* Crucial: lets click events pass through */
}

/* Glass shine on static cover */
.wheel-static-bezel::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 55%),
              linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 45%, rgba(0, 0, 0, 0.04) 55%, rgba(0, 0, 0, 0.08) 100%);
  pointer-events: none;
}

/* Inner concentric dashed golden watchmaker ring on static cover */
.wheel-static-bezel::after {
  content: '';
  position: absolute;
  left: 6rpx; /* Sits exactly inside the 12rpx border */
  top: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  border: 2rpx dashed rgba(217, 156, 82, 0.35);
  border-radius: 50%;
  pointer-events: none;
}

.wheel-slice {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 50%;
  height: 80rpx; /* Increased from 40rpx to allow 2 lines of text */
  margin-top: -40rpx; /* Center-aligned for 80rpx height */
  transform-origin: left center;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-right: 70rpx; /* Pushed inward to give margin away from the outer ring */
  box-sizing: border-box;
}

.wheel-slice-text {
  color: #2c3e35;
  font-size: 25rpx; /* Default premium size, overridden dynamically */
  font-weight: 600; /* Sophisticated medium bold */
  line-height: 1.2;
  white-space: nowrap;
  letter-spacing: 1.5rpx;
  max-width: 210rpx; /* Expanded space to prevent text overflow clash with center bezel */
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 2rpx rgba(255, 255, 255, 0.8); /* Elegant letterpress engraving look */
}

.wheel-slice-text.multiline {
  white-space: normal; /* Allow natural text wrapping */
  word-break: break-all;
  text-align: right;
  line-height: 1.15;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; /* Clamp to max 2 lines */
  max-height: 72rpx;
  overflow: hidden;
  padding: 2rpx 8rpx; /* Safe padding boundary to prevent boundary bleeding */
}

.wheel-slice-text.high-score {
  font-weight: 700;
  color: #0f766e; /* Distinguish high-score recommendations with deep teal */
}

.wheel-center-bezel {
  background: radial-gradient(circle at 35% 35%, #4b5563 0%, #1f2937 100%); /* Watchmaker titanium slate bezel */
  border: 4rpx solid #e5cda6; /* Champagne gold border matching the outer rim */
  border-radius: 50%;
  height: 94rpx;
  width: 94rpx;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.35), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.15);
}

.confetti-canvas {
  background: transparent;
  height: 620rpx;
  width: 620rpx;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 8;
  pointer-events: none;
}

.wheel-pointer {
  height: 94rpx;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 94rpx;
  z-index: 10;
}

.pointer-arrow {
  height: 48rpx;
  left: 50%;
  position: absolute;
  top: -42rpx;
  transform: translateX(-50%);
  width: 28rpx;
  filter: drop-shadow(0 -4rpx 6rpx rgba(0, 0, 0, 0.25));
}

/* Left half of 3D Gold Compass Needle */
.pointer-arrow::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  border-bottom: 48rpx solid #f6e3c5; /* High-light gold face */
  border-left: 14rpx solid transparent;
}

/* Right half of 3D Gold Compass Needle */
.pointer-arrow::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  width: 0;
  height: 0;
  border-bottom: 48rpx solid #c8a261; /* Shadow gold face */
  border-right: 14rpx solid transparent;
}

.pointer-center {
  background: radial-gradient(circle at 35% 35%, #374151 0%, #111827 100%); /* Watchmaker titanium slate center cap */
  border: 4rpx solid #e5cda6; /* Champagne gold border matching the outer rim */
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
  height: 94rpx;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 94rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  animation: pulse-gold 2.5s infinite ease-in-out;
}

.pointer-center:active {
  transform: translate(-50%, -50%) scale(0.92);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
  animation: none;
}

.pointer-center::after {
  color: #fef3c7; /* Warm soft cream gold */
  content: "GO";
  font-size: 26rpx;
  font-weight: 800;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4), 0 0 8rpx rgba(245, 158, 11, 0.5); /* Glow shadow */
}

@keyframes pulse-gold {
  0% {
    box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
    border-color: #e5cda6;
  }
  50% {
    box-shadow: 0 8rpx 28rpx rgba(229, 205, 166, 0.45), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
    border-color: #f6e3c5;
  }
  100% {
    box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
    border-color: #e5cda6;
  }
}

.wheel-status-text {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-bottom: 24rpx;
  min-height: 100rpx;
  text-align: center;
}

.wheel-result-title {
  color: #0f766e;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.3;
}

.wheel-result-sub {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.mode-row {
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(2, 1fr);
}

.mode-chip {
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(15, 118, 110, 0.12);
  border-radius: 14rpx;
  padding: 18rpx;
}

.mode-chip.active {
