  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
}

.mode-desc {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 6rpx;
}

.spin-btn {
  margin-top: 22rpx;
  width: 100%;
}

.result-card {
  margin-top: 24rpx;
  padding: 36rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 16rpx 40rpx rgba(58, 175, 169, 0.15);
  animation: card-slide-up 0.5s cubic-bezier(0.18, 0.89, 0.32, 1.28) both;
}

@keyframes card-slide-up {
  0% {
    opacity: 0;
    transform: translateY(30rpx) scale(0.96);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.result-kicker {
  color: #0f766e;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.3;
}

.result-title {
  color: #1f2933;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
