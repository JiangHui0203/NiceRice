  margin-bottom: 16rpx;
}

.history-empty-title {
  font-size: 28rpx;
  font-weight: 750;
  color: #334155;
  margin-bottom: 8rpx;
}

.history-empty-text {
  font-size: 24rpx;
  color: #94a3b8;
  max-width: 480rpx;
  line-height: 1.4;
}

.history-scroll {
  max-height: 640rpx;
  padding: 16rpx 4rpx 32rpx;
  box-sizing: border-box;
}

.history-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.85);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
}

.history-item-title {
  font-size: 28rpx;
  font-weight: 750;
  color: #0f172a;
}

.history-item-time {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.history-use-btn {
  font-size: 22rpx;
  font-weight: 700;
  color: #0d9488;
  background: rgba(13, 148, 136, 0.08);
  border: 1rpx solid rgba(13, 148, 136, 0.2);
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.history-use-btn:active {
  background: rgba(13, 148, 136, 0.18);
  transform: scale(0.96);
}
