<view class="page wheel-page">
  <view class="page-header wheel-page-header">
    <view>
      <view class="eyebrow">选择困难</view>
      <view class="page-title">今天吃啥</view>
    </view>
    <view class="header-history-btn" bindtap="toggleHistoryDrawer">📜 记录</view>
  </view>

  <view class="wheel-hero card">
    <view class="wheel-container">
      <view class="wheel-disk" 
            style="background: {{conicGradientStyle}}; transform: rotate({{wheelRotation || 0}}deg); transition: {{wheelTransitionStyle || 'none'}};">
        <view class="wheel-slice" 
              wx:for="{{wheelSlices}}" 
              wx:key="id" 
              style="transform: rotate({{item.midAngle - 90}}deg);">
          <text class="wheel-slice-text {{item.isHighScore ? 'high-score' : ''}} {{item.isMultiline ? 'multiline' : ''}}" style="font-size: {{item.fontSize}}rpx; max-width: {{item.maxWidth}}rpx; color: {{item.textColor}};">{{item.title}}</text>
        </view>
      </view>
      <view class="wheel-static-bezel"></view>
      <view class="wheel-center-bezel"></view>
      <canvas type="2d" 
              id="wheelCanvas" 
              class="confetti-canvas">
      </canvas>
      <view class="wheel-pointer">
        <view class="pointer-arrow"></view>
        <view class="pointer-center" bindtap="spin"></view>
      </view>
    </view>
    <view class="wheel-status-text">
      <view class="wheel-result-title" wx:if="{{result}}">{{result.title}}</view>
      <view class="wheel-result-sub">{{result ? result.reason : spinning ? '正在美味转动...' : mode === 'random' ? '纯随机模式 (概率均等)' : '权重随机模式 (临期优先)'}}</view>
    </view>
    <view class="mode-row">
      <view class="mode-chip {{mode === 'random' ? 'active' : ''}}" data-mode="random" bindtap="selectMode">
        <view class="mode-title">纯随机</view>
        <view class="mode-desc">每项概率相同</view>
      </view>
      <view class="mode-chip {{mode === 'weighted' ? 'active' : ''}}" data-mode="weighted" bindtap="selectMode">
        <view class="mode-title">权重随机</view>
        <view class="mode-desc">临期优先一点</view>
      </view>
    </view>
    <button class="btn btn-primary spin-btn" bindtap="spin" loading="{{spinning}}" disabled="{{spinning || !enabledCount}}">{{spinning ? '正在转' : '开始'}}</button>
  </view>

  <view class="result-card card" wx:if="{{resultVisible && result}}">
    <view class="result-header-row">
      <view class="result-kicker">这次选</view>
      <view class="result-score-badge" wx:if="{{result.source === 'coupon' && result.score}}">✨ 适合度 {{result.score}}%</view>
    </view>
    <view class="result-title">{{result.title}}</view>
    <view class="result-subtitle">{{result.subtitle}}</view>
    
    <!-- 推荐理由胶囊列表 -->
    <view class="result-reasons-list" wx:if="{{result.reasons && result.reasons.length}}">
      <view class="result-reason-tag" wx:for="{{result.reasons}}" wx:key="*this">{{item}}</view>
    </view>
    
    <view class="result-reason" wx:else>{{result.reason}}</view>

    <!-- 风险警告条目 -->
    <view class="result-warnings-list" wx:if="{{result.warnings && result.warnings.length}}">
      <view class="result-warning-item" wx:for="{{result.warnings}}" wx:key="*this">
        <text class="warning-icon">⚠️</text>
        <text class="warning-text">{{item}}</text>
      </view>
    </view>

    <!-- 快速直达时段安排 -->
    <view class="quick-schedule-section">
      <view class="quick-schedule-title">⚡ 快速安排到时段</view>
      <view class="quick-schedule-grid">
        <view class="quick-slot-card" bindtap="quickScheduleSlot" data-slot="today_lunch">
          <view class="slot-badge">今天 12:00</view>
          <view class="slot-text">吃午餐</view>
        </view>
        <view class="quick-slot-card highlight" bindtap="quickScheduleSlot" data-slot="today_dinner">
          <view class="slot-badge">今天 18:30</view>
          <view class="slot-text">吃晚餐</view>
        </view>
        <view class="quick-slot-card" bindtap="quickScheduleSlot" data-slot="tomorrow_dinner">
          <view class="slot-badge">明天 18:30</view>
          <view class="slot-text">预定明天</view>
        </view>
      </view>
    </view>

    <view class="result-actions">
      <button class="btn btn-primary result-action-main" bindtap="addResultToPlan" loading="{{planSubmitting}}" disabled="{{planSubmitting}}">{{result.source === 'coupon' ? '自定义时段' : '自定义安排'}}</button>
      <button class="btn btn-secondary result-action-sub" open-type="share">✉️ 约好友吃这个</button>
      <button class="btn btn-ghost result-action-sub" bindtap="spinAgain">再转一次</button>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">候选池</view>
      <view class="section-head-right">
        <view class="section-action-text">{{filterSummary}} · {{enabledCount}} 项</view>
        <view class="toggle-all-btn" bindtap="toggleAllCandidates">{{allEnabled ? '全不选' : '全选'}}</view>
      </view>
    </view>
    <view class="candidate-stats">
      <view class="stat-card card">
        <view class="stat-value">{{couponCount}}</view>
        <view class="stat-label">待用券</view>
      </view>
      <view class="stat-card card">
        <view class="stat-value">{{customCount}}</view>
        <view class="stat-label">自定义</view>
      </view>
    </view>
  </view>

  <!-- 场景化一键预设包 -->
  <view class="scenario-pack-card card" style="padding: 16rpx 20rpx; margin-bottom: 20rpx; background: rgba(58, 175, 169, 0.04); border-radius: 16rpx; border: 1rpx solid rgba(58, 175, 169, 0.15);">
    <view style="font-size: 21rpx; font-weight: 800; color: #0f766e; margin-bottom: 10rpx;">📦 场景预设候选包 (一键替换)：</view>
    <view style="display: flex; gap: 10rpx; flex-wrap: wrap;">
      <view class="tag compact" bindtap="applyScenarioPack" data-pack="workday" style="font-size: 20rpx; padding: 6rpx 14rpx; background: #ffffff; color: #0f766e; border: 1rpx solid rgba(15, 118, 110, 0.2); font-weight: 700;">💼 工作日便饭</view>
      <view class="tag compact" bindtap="applyScenarioPack" data-pack="diet" style="font-size: 20rpx; padding: 6rpx 14rpx; background: #ffffff; color: #16a34a; border: 1rpx solid rgba(22, 163, 74, 0.2); font-weight: 700;">🥗 减脂轻食</view>
      <view class="tag compact" bindtap="applyScenarioPack" data-pack="night" style="font-size: 20rpx; padding: 6rpx 14rpx; background: #ffffff; color: #ea580c; border: 1rpx solid rgba(234, 88, 12, 0.2); font-weight: 700;">🍢 深夜食堂</view>
      <view class="tag compact" bindtap="applyScenarioPack" data-pack="tea" style="font-size: 20rpx; padding: 6rpx 14rpx; background: #ffffff; color: #9333ea; border: 1rpx solid rgba(147, 51, 234, 0.2); font-weight: 700;">☕ 悠闲下午茶</view>
    </view>
  </view>

  <view class="filter-card card">
    <view class="filter-row">
      <view
        wx:for="{{sourceFilters}}"
        wx:key="value"
        class="filter-chip {{sourceFilter === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="selectSourceFilter"
      >{{item.label}}</view>
    </view>
    <scroll-view class="category-filter-scroll" scroll-x="true" show-scrollbar="false">
      <view class="category-filter-row">
        <view class="category-filter-chip {{activeCategory === 'all' ? 'active' : ''}}" data-value="all" bindtap="selectCategoryFilter">全部</view>
        <view
          wx:for="{{categoryFilters}}"
          wx:key="label"
          class="category-filter-chip {{activeCategory === item.label ? 'active' : ''}}"
          data-value="{{item.label}}"
          bindtap="selectCategoryFilter"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="custom-card card">
    <view class="custom-input-row">
      <input class="custom-input" placeholder="手动加一个，比如拉面、外卖、食堂" value="{{customTitle}}" maxlength="80" bindinput="onCustomInput" />
      <button class="custom-add" bindtap="addCustom">添加</button>
    </view>
    <!-- 热门灵感预设标签 -->
    <view class="preset-inspiration-wrap">
      <view class="preset-inspiration-label">💡 快速灵感 (点击加入):</view>
      <scroll-view class="preset-scroll" scroll-x="true" show-scrollbar="false">
        <view class="preset-chips-row">
          <view class="preset-chip" wx:for="{{popularPresets}}" wx:key="*this" data-tag="{{item}}" bindtap="addPresetTag">+ {{item}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="candidate-list">
    <view wx:if="{{!candidates.length}}" class="empty-card card">
      <view class="empty-title">暂无候选</view>
      <view class="empty-desc">切回全部大类或手动添加。</view>
    </view>
    <view
      class="candidate-card card {{item.enabled ? 'enabled' : ''}} {{item.blocked ? 'blocked' : ''}}"
      wx:for="{{candidates}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="toggleCandidate"
    >
      <view class="candidate-main">
        <view class="candidate-top">
          <view class="candidate-source {{item.source}}">{{item.source === 'coupon' ? '券' : '自定义'}}</view>
          <view class="candidate-category">{{item.categoryLabel}}</view>
          <view class="candidate-weight" wx:if="{{mode === 'weighted' && !item.blocked}}">权重 {{item.weight}}</view>
          <view class="candidate-weight blocked-text" wx:if="{{item.blocked}}">暂不建议</view>
        </view>
        <view class="candidate-title">{{item.title}}</view>
        <view class="candidate-subtitle">{{item.subtitle}}</view>
        <view class="candidate-reason">{{item.reason}}</view>
      </view>
      <view class="candidate-side">
        <view class="toggle-dot {{item.enabled ? 'on' : ''}}"></view>
        <button
          wx:if="{{item.source === 'custom'}}"
          class="remove-btn"
          catchtap="removeCustom"
          data-id="{{item.id}}"
        >删除</button>
      </view>
    </view>
    <button
      wx:if="{{hasMoreCandidates}}"
      class="btn btn-secondary"
      bindtap="loadMoreCandidates"
      style="margin-top: 8rpx;"
    >显示更多（已显示 {{candidateVisibleCount}} / 共 {{candidateTotalCount}} 项）</button>
  </view>

  <page-container
    show="{{showHistoryDrawer}}"
    position="bottom"
    round="true"
    overlay="true"
    custom-style="padding: 0; background: transparent; border-radius: 40rpx 40rpx 0 0;"
    bindbeforeleave="toggleHistoryDrawer"
  >
    <view class="history-drawer">
      <!-- 顶部 iOS 居中把手 -->
      <view class="drawer-drag-handle"></view>

      <view class="history-drawer-head">
        <view class="history-drawer-title">
          <text class="history-title-icon">📜</text>
          <text>近期抽中记录</text>
          <text class="history-count-badge" wx:if="{{historyList.length}}">{{historyList.length}}</text>
        </view>
        <view class="history-drawer-actions">
          <view class="history-clear-btn" bindtap="clearHistory" wx:if="{{historyList.length}}" hover-class="ios-hover">清空记录</view>
          <view class="history-close-btn" bindtap="toggleHistoryDrawer" hover-class="ios-hover">✕</view>
        </view>
      </view>

      <view class="history-empty" wx:if="{{!historyList.length}}">
        <view class="history-empty-icon">🎲</view>
        <view class="history-empty-title">暂无抽中记录</view>
        <view class="history-empty-text">每次转动转盘决定的结果都会自动记录在此</view>
      </view>
      <scroll-view class="history-scroll" scroll-y="true" wx:else>
        <view class="history-item-row" wx:for="{{historyList}}" wx:for-index="historyIndex" wx:key="index">
          <view class="history-item-left">
            <view class="history-item-title">{{item.title}}</view>
            <view class="history-item-time">{{item.timeText || '近期'}} · {{item.source === 'coupon' ? '优惠券' : '自定义'}}</view>
          </view>
          <view class="history-use-btn" bindtap="quickScheduleFromHistory" data-index="{{historyIndex}}" hover-class="ios-hover">载入结果</view>
        </view>
      </scroll-view>
    </view>
  </page-container>
</view>
