<view class="page detail-page">
  <view wx:if="{{errorMsg}}" style="padding: 24rpx; background: #fee2e2; color: #991b1b; border-radius: 16rpx; margin-bottom: 20rpx; font-size: 26rpx;">
    <view style="font-weight: 700;">加载失败：</view>
    <text>{{errorMsg}}</text>
  </view>

  <block wx:if="{{coupon}}">
  <!-- Recipient Share Import Banner -->
  <view class="share-import-banner card" wx:if="{{isFromShare && !isSavedToLocal}}" style="display: flex; justify-content: space-between; align-items: center; padding: 24rpx 28rpx; background: rgba(58, 175, 169, 0.08); border: 1rpx solid rgba(58, 175, 169, 0.25); border-radius: 20rpx; margin-bottom: 24rpx;">
    <view style="display: flex; flex-direction: column;">
      <text style="font-size: 28rpx; font-weight: 700; color: var(--primary-color);">🎁 好友分享的优惠好券</text>
      <text style="font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx;">存入后可在您的券包中管理或智能安排就餐</text>
    </view>
    <button class="btn btn-primary compact" bindtap="saveSharedCouponToWallet" style="font-size: 24rpx; height: 64rpx; line-height: 64rpx; padding: 0 28rpx; border-radius: 32rpx; font-weight: 700;">
      📥 存入券包
    </button>
  </view>

  <!-- 1. Hero Card -->
  <view class="detail-hero card">
    <view class="detail-top-row">
      <view class="detail-platform-badge {{detailView.platformClass}}">
        <text class="platform-icon">{{detailView.platformIcon}}</text>
        <text class="platform-name">{{detailView.platform}}</text>
        <text class="type-divider">·</text>
        <text class="type-label">{{coupon.type}} · {{detailView.peopleText}}</text>
      </view>
      <view class="detail-top-actions">
        <text class="edit-link" bindtap="editCoupon">编辑</text>
        <text class="delete-link" bindtap="deleteCoupon">删除</text>
      </view>
    </view>

    <view class="detail-title">
      {{coupon.title}}
    </view>
    
    <view class="detail-venue-capsule">
      <view class="venue-main-btn" bindtap="onVenueTap" bindlongpress="onVenueLongPress">
        <text class="venue-icon">📍</text>
        <text class="detail-venue">{{coupon.venue || locationView.name || '商家位置待补充'}}</text>
        <text class="detail-distance" wx:if="{{detailView.distanceDisplay}}">· {{detailView.distanceDisplay}}</text>
        <view class="venue-arrow"></view>
      </view>
      <view class="venue-divider"></view>
      <view class="venue-copy-btn" catchtap="copyAddress">
        <view class="copy-icon-box">
          <view class="copy-icon-back"></view>
          <view class="copy-icon-front"></view>
        </view>
      </view>
    </view>

    <!-- Price & Savings Row -->
    <view class="detail-price-row" wx:if="{{coupon.price}}">
      <view class="price-main">
        <text class="currency-symbol">¥</text>
        <text class="price-value">{{coupon.price}}</text>
      </view>
      <text class="original-price" wx:if="{{coupon.originalPrice}}">原价 ¥{{coupon.originalPrice}}</text>
      <view class="savings-tag" wx:if="{{detailView.savedAmount > 0}}">立省 ¥{{detailView.savedAmount}}</view>
      <view class="discount-tag" wx:if="{{detailView.discountRate > 0}}">{{detailView.discountRate}}折</view>
    </view>

    <!-- Score & Deadline Dual Cards -->
    <view class="detail-score-row">
      <view class="score-block">
        <view class="score-value">{{coupon.score !== null && coupon.score !== undefined ? coupon.score + '%' : '待评估'}}</view>
        <view class="score-label">AI适合度</view>
      </view>
      <view class="deadline-block">
        <view class="deadline">{{coupon.expiresIn}}</view>
        <view class="deadline-sub">{{coupon.recommendedAt ? '推荐 ' + coupon.recommendedAt : '推荐时段待评估'}}</view>
      </view>
    </view>

    <!-- Feature Tags -->
    <view class="tag-list" wx:if="{{coupon.tags && coupon.tags.length}}">
      <view class="tag green" wx:for="{{coupon.tags}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 2. Dishes / Menu Details Card (套餐内容包含 - 可折叠手风琴) -->
  <view class="section {{highlightSection === 'dishes' ? 'section-highlight' : ''}}" id="section-dishes" wx:if="{{detailView.hasDishes}}">
    <view class="section-head clickable" bindtap="toggleSection" data-section="dishes">
      <view class="section-title">🍽️ 套餐包含内容</view>
      <view class="section-head-right">
        <view class="section-action" wx:if="{{detailView.parsedDishes.length}}">共 {{detailView.parsedDishes.length}} 项</view>
        <view class="accordion-chevron {{expandedSections.dishes ? 'expanded' : ''}}"></view>
      </view>
    </view>
    <view class="card dishes-card" wx:if="{{expandedSections.dishes}}">
      <view class="dishes-list">
        <view class="dish-row" wx:for="{{detailView.parsedDishes}}" wx:key="id">
          <view class="dish-bullet"></view>
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-count" wx:if="{{item.count}}">{{item.count}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3. Usage Conditions & Service Guarantees Card (结构化使用条件与服务保障 - 可折叠手风琴) -->
  <view class="section {{highlightSection === 'rules' ? 'section-highlight' : ''}}" id="section-rules">
    <view class="section-head clickable" bindtap="toggleSection" data-section="rules">
      <view class="section-title">📋 使用规则与服务保障</view>
      <view class="section-head-right">
        <view class="accordion-chevron {{expandedSections.rules ? 'expanded' : ''}}"></view>
      </view>
    </view>
    <view class="card conditions-card" wx:if="{{expandedSections.rules}}">
      <view class="condition-row" wx:for="{{detailView.conditions}}" wx:key="label">
        <view class="condition-left">
          <view class="condition-bullet"></view>
          <text class="condition-label">{{item.label}}</text>
        </view>
        <view class="condition-value {{item.isHighlight ? 'highlight' : ''}} {{item.isSafe ? 'safe' : ''}} {{item.isAddress ? 'address-val' : ''}}">
          <text class="condition-text">{{item.value}}</text>
          <view class="inline-copy-btn" wx:if="{{item.isAddress}}" catchtap="copyAddress">
            <view class="copy-icon-box">
              <view class="copy-icon-back"></view>
              <view class="copy-icon-front"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 5. Screenshots Section (券面原图截图 - 可折叠手风琴) -->
  <view class="section {{highlightSection === 'screenshots' ? 'section-highlight' : ''}}" id="section-screenshots" wx:if="{{coupon.screenshots && coupon.screenshots.length}}">
    <view class="section-head clickable" bindtap="toggleSection" data-section="screenshots">
      <view class="section-title">🖼️ 券面原图截图</view>
      <view class="section-head-right">
        <view class="section-action">{{coupon.screenshots.length}} 张</view>
        <view class="accordion-chevron {{expandedSections.screenshots ? 'expanded' : ''}}"></view>
      </view>
    </view>
    <view class="card screenshot-card" wx:if="{{expandedSections.screenshots}}">
      <view class="screenshot-grid">
        <view
          class="screenshot-thumb"
          wx:for="{{coupon.screenshots}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="previewScreenshot"
        >
          <image class="screenshot-img" src="{{item.previewUrl}}" mode="aspectFill" lazy-load="true" />
        </view>
      </view>
    </view>
  </view>

  <!-- 6. Recommendation Reasoning & Warnings (AI 推荐依据 - 可折叠手风琴) -->
  <view class="section {{highlightSection === 'recommendation' ? 'section-highlight' : ''}}" id="section-recommendation" wx:if="{{coupon.reasonItems && coupon.reasonItems.length}}">
    <view class="section-head clickable" bindtap="toggleSection" data-section="recommendation">
      <view class="section-title">💡 AI 推荐依据</view>
      <view class="section-head-right">
        <view class="accordion-chevron {{expandedSections.recommendation ? 'expanded' : ''}}"></view>
      </view>
    </view>
    <view class="card list-card" wx:if="{{expandedSections.recommendation}}">
      <view class="reason-row" wx:for="{{coupon.reasonItems}}" wx:key="label">
        <view class="reason-badge {{item.type || 'default'}}">{{item.label}}</view>
        <view class="reason-text">
          <view class="reason-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section {{highlightSection === 'warnings' ? 'section-highlight' : ''}}" id="section-warnings" wx:if="{{blockers.length || warnings.length}}">
    <view class="section-head clickable" bindtap="toggleSection" data-section="warnings">
      <view class="section-title" style="color: #d97706;">⚠️ 避坑与风险提示</view>
      <view class="section-head-right">
        <view class="accordion-chevron {{expandedSections.warnings ? 'expanded' : ''}}"></view>
      </view>
    </view>
    <view class="card list-card blocked-card" wx:if="{{expandedSections.warnings}}">
      <view class="notice-row danger" wx:for="{{blockers}}" wx:key="*this">🚫 {{item}}</view>
      <view class="notice-row warning" wx:for="{{warnings}}" wx:key="*this">⚠️ {{item}}</view>
    </view>
  </view>

  <!-- 5. 个人备注与备忘 (User Note - 可折叠手风琴) -->
  <view class="section {{highlightSection === 'note' ? 'section-highlight' : ''}}" id="section-note" wx:if="{{coupon.note}}">
    <view class="section-head clickable" bindtap="toggleSection" data-section="note">
      <view class="section-title">📝 个人备注与备忘</view>
      <view class="section-head-right">
        <view class="accordion-chevron {{expandedSections.note ? 'expanded' : ''}}"></view>
      </view>
    </view>
    <view class="card list-card note-card" wx:if="{{expandedSections.note}}">
      <view class="user-note-content">{{coupon.note}}</view>
    </view>
  </view>

  <!-- 6. 智能履约提醒 (System Smart Reminders - 可折叠手风琴) -->
  <view class="section {{highlightSection === 'reminders' ? 'section-highlight' : ''}}" id="section-reminders" wx:if="{{detailView.smartReminders && detailView.smartReminders.length}}">
    <view class="section-head clickable" bindtap="toggleSection" data-section="reminders">
      <view class="section-title">💡 智能履约提醒</view>
      <view class="section-head-right">
        <view class="accordion-chevron {{expandedSections.reminders ? 'expanded' : ''}}"></view>
      </view>
    </view>
    <view class="card list-card" wx:if="{{expandedSections.reminders}}">
      <view class="notice-row" wx:for="{{detailView.smartReminders}}" wx:key="*this">💡 {{item}}</view>
    </view>
  </view>

  <!-- Direct Complete Dialog -->
  <view class="use-dialog-mask {{showUseDialog ? 'show' : ''}}" bindtap="closeUseDialog">
    <view class="use-dialog card" catchtap="stopPropagation" style="{{useDialogDragY ? 'transform: translateY(' + useDialogDragY + 'px);' : ''}}">
      <view class="modal-pull-handle-bar" bindtouchstart="onUseDialogTouchStart" bindtouchmove="onUseDialogTouchMove" bindtouchend="onUseDialogTouchEnd">
        <view class="pull-handle-indicator"></view>
      </view>
      <view class="use-dialog-title" bindtouchstart="onUseDialogTouchStart" bindtouchmove="onUseDialogTouchMove" bindtouchend="onUseDialogTouchEnd">记录直接使用</view>
      
      <view class="use-dialog-form">
        <view class="use-form-item">
          <view class="use-form-label">使用日期</view>
          <picker mode="date" value="{{useDate}}" bindchange="onUseDateChange">
            <view class="use-form-picker-val">{{useDate}}</view>
          </picker>
        </view>
        
        <view class="use-form-item">
          <view class="use-form-label">使用时间</view>
          <picker mode="time" value="{{useTime}}" bindchange="onUseTimeChange">
            <view class="use-form-picker-val">{{useTime}}</view>
          </picker>
        </view>
        
        <view class="use-form-item" style="border-bottom: none;">
          <view class="use-form-label">记录备注</view>
          <input class="use-form-input" placeholder="（选填）例如：到店直接核销" value="{{useNote}}" bindinput="onUseNoteInput" placeholder-style="color: var(--text-muted);" />
        </view>
      </view>
      
      <view class="use-dialog-actions">
        <button class="btn btn-secondary" bindtap="closeUseDialog">取消</button>
        <button class="btn btn-primary" bindtap="submitUseDirectly">确认完成</button>
      </view>
    </view>
  </view>

  <!-- Single-row Compact iOS Bottom Action Bar -->
  <view class="bottom-actions" wx:if="{{coupon.statusCode === 'expired'}}">
    <button class="btn btn-secondary action-sub-btn" bindtap="markAsUsedDirectly">直接核销</button>
    <button class="btn btn-renew action-main-btn" bindtap="openExtendDialog">🔄 快捷延期</button>
  </view>
  <view class="bottom-actions" wx:elif="{{coupon.statusCode === 'used'}}">
    <button class="btn btn-secondary disabled-state-btn" disabled="true">已使用完成</button>
  </view>
  <view class="bottom-actions" wx:elif="{{coupon.statusCode === 'planned'}}">
    <button class="btn btn-secondary action-sub-btn" bindtap="markAsUsedDirectly">直接核销</button>
    <button class="btn btn-primary action-main-btn" bindtap="viewLinkedPlan">📅 查看关联计划</button>
  </view>
  <view class="bottom-actions" wx:else>
    <button class="btn btn-secondary action-sub-btn" bindtap="markAsUsedDirectly">直接核销</button>
    <button class="btn btn-primary action-main-btn" bindtap="addToPlan">🗓️ 安排到日程</button>
    <button class="btn btn-secondary action-sub-btn" bindtap="changeTime">换时间</button>
  </view>
  </block>
</view>
