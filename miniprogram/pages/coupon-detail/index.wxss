/* ==========================================================================
   Coupon Detail Redesign (Dishes List, Hero Card & Structured Conditions)
   ========================================================================== */

.detail-page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 1. Hero Card */
.detail-hero {
  background: var(--card-bg, #ffffff);
  padding: 28rpx 24rpx;
  border-radius: var(--card-radius, 20rpx);
  box-shadow: var(--shadow-soft, 0 4rpx 16rpx rgba(0, 0, 0, 0.02));
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.detail-top-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.detail-platform-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(58, 175, 169, 0.08);
  color: #0d9488;
}

.detail-platform-badge.meituan {
  background: rgba(254, 219, 58, 0.25);
  color: #b45309;
}

.detail-platform-badge.dianping {
  background: rgba(249, 115, 22, 0.12);
  color: #ea580c;
}

.detail-platform-badge.douyin {
  background: rgba(239, 68, 68, 0.12);
  color: #dc2626;
}

.type-divider {
  opacity: 0.5;
  margin: 0 2rpx;
}

.detail-top-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.edit-link {
  background: var(--primary-light, #e8f8f7);
  border-radius: 12rpx;
  color: var(--primary-color, #3aafa9);
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
  line-height: 1.2;
}

.delete-link {
  color: #dc2626;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 10rpx;
  line-height: 1.2;
}

.detail-title {
  color: var(--text-primary, #0f172a);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
  margin-top: 16rpx;
}

.warning-badge-pill {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #d97706;
}

.detail-venue-capsule {
  display: inline-flex;
  align-items: center;
  margin-top: 14rpx;
  background: rgba(58, 175, 169, 0.06);
  border: 1rpx solid rgba(58, 175, 169, 0.18);
  border-radius: 16rpx;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.venue-main-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 14rpx;
  transition: background 0.15s ease;
  flex: 1;
  min-width: 0;
}

.venue-main-btn:active {
  background: rgba(58, 175, 169, 0.12);
}

.venue-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.detail-venue {
  color: var(--text-secondary, #334155);
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-distance {
  color: var(--primary-color, #0d9488);
  font-size: 25rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.venue-arrow {
  display: inline-block;
  width: 9rpx;
  height: 9rpx;
  border-top: 3rpx solid #94a3b8;
  border-right: 3rpx solid #94a3b8;
  transform: rotate(45deg);
  margin-left: 6rpx;
  flex-shrink: 0;
}

.venue-divider {
  width: 1rpx;
  height: 24rpx;
  background: rgba(58, 175, 169, 0.25);
  flex-shrink: 0;
}

.venue-copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 14rpx;
  background: rgba(58, 175, 169, 0.04);
  transition: background 0.15s ease;
  flex-shrink: 0;
}

.venue-copy-btn:active {
  background: rgba(58, 175, 169, 0.2);
}

/* Classic Dual-Sheet Copy Icon */
.copy-icon-box {
  width: 24rpx;
  height: 24rpx;
  position: relative;
  display: inline-block;
  flex-shrink: 0;
}

.copy-icon-back {
  position: absolute;
  top: 0;
  right: 0;
  width: 17rpx;
  height: 17rpx;
  border: 2.2rpx solid #0d9488;
  border-radius: 4rpx;
  box-sizing: border-box;
  opacity: 0.55;
}

.copy-icon-front {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 17rpx;
  height: 17rpx;
  background: #ffffff;
  border: 2.2rpx solid #0d9488;
  border-radius: 4rpx;
  box-sizing: border-box;
}

/* Price & Savings Row */
.detail-price-row {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.price-main {
  color: var(--primary-color, #3aafa9);
  display: flex;
  align-items: baseline;
}

.currency-symbol {
  font-size: 28rpx;
  font-weight: 900;
}

.price-value {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  line-height: 1;
}

.original-price {
  color: var(--text-muted, #94a3b8);
  font-size: 26rpx;
  text-decoration: line-through;
}

.savings-tag {
  background: rgba(226, 92, 92, 0.08);
  border-radius: 8rpx;
  color: #e25c5c;
  font-size: 22rpx;
  font-weight: 800;
  padding: 4rpx 10rpx;
}

.discount-tag {
  background: rgba(58, 175, 169, 0.1);
  border-radius: 8rpx;
  color: #0d9488;
  font-size: 22rpx;
  font-weight: 800;
  padding: 4rpx 10rpx;
}

/* Score & Deadline Dual Cards - Compact Height */
.detail-score-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.score-block {
  background: rgba(58, 175, 169, 0.06);
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.score-value {
  color: var(--primary-color, #3aafa9);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.1;
}

.score-label,
.deadline-sub {
  color: var(--text-muted, #94a3b8);
  font-size: 20rpx;
  margin-top: 2rpx;
  font-weight: 500;
  line-height: 1;
}

.deadline-block {
  background: rgba(0, 0, 0, 0.025);
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.deadline {
  color: var(--text-primary, #0f172a);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.1;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

/* Accordion Head & Section Highlighting */
.section {
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  border-radius: 20rpx;
}

.section-head.clickable {
  cursor: pointer;
  user-select: none;
}

.section-head.clickable:active {
  opacity: 0.75;
}

.section-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.accordion-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid #94a3b8;
  border-bottom: 3rpx solid #94a3b8;
  transform: rotate(45deg);
  transition: transform 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
  margin-top: -4rpx;
  flex-shrink: 0;
}

.accordion-chevron.expanded {
  transform: rotate(-135deg);
  margin-top: 4rpx;
  border-color: var(--primary-color, #0F766E);
}

.section-highlight {
  animation: section-pulse 2s ease-out;
}

@keyframes section-pulse {
  0% {
    transform: scale(1.02);
    box-shadow: 0 0 0 8rpx rgba(15, 118, 110, 0.35);
  }
  50% {
    transform: scale(1.01);
    box-shadow: 0 0 0 4rpx rgba(15, 118, 110, 0.18);
  }
  100% {
    transform: scale(1);
    box-shadow: none;
  }
}

/* 2. Dishes Section */
.dishes-card {
  padding: 12rpx 20rpx !important;
}

.dishes-list {
  display: flex;
  flex-direction: column;
}

.dish-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.dish-row:last-child {
  border-bottom: none;
}

.dish-bullet {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary-color, #3aafa9);
  flex-shrink: 0;
}

.dish-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  line-height: 1.4;
}

.dish-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f766e;
  background: rgba(15, 118, 110, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 3. Conditions & Guarantees Card */
.conditions-card {
  padding: 8rpx 24rpx !important;
}

.condition-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.condition-row:last-child {
  border-bottom: none;
}

.condition-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.condition-bullet {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary-color, #3aafa9);
  flex-shrink: 0;
}

.condition-label {
  font-size: 25rpx;
  color: #64748b;
  font-weight: 600;
}

.condition-value {
  font-size: 25rpx;
  color: #0f172a;
  font-weight: 700;
  text-align: right;
  max-width: 440rpx;
}

.condition-value.highlight {
  color: #d97706;
  font-weight: 800;
}

.condition-value.safe {
  color: #0d9488;
  font-weight: 800;
}

.condition-value.address-val {
  display: flex;
  align-items: center;
  gap: 12rpx;
  justify-content: flex-end;
}

.condition-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 340rpx;
}

.inline-copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(58, 175, 169, 0.08);
  padding: 8rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  transition: background 0.15s ease;
}

.inline-copy-btn:active {
  background: rgba(58, 175, 169, 0.25);
}

/* 5. Screenshots Card */
.screenshot-card {
  padding: 20rpx !important;
}

.screenshot-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(3, 1fr);
}

.screenshot-thumb {
  background: rgba(58, 175, 169, 0.03);
  border-radius: 16rpx;
  height: 200rpx;
  overflow: hidden;
}

.screenshot-img {
  display: block;
  height: 100%;
  width: 100%;
}

/* 6. Reason & Warning List Cards */
.list-card {
  padding: 8rpx 24rpx !important;
}

.reason-row {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
}

.reason-row + .reason-row {
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.reason-desc {
  color: #475569;
  font-size: 25rpx;
  line-height: 1.5;
}

.notice-row {
  padding: 18rpx 0;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.45;
}

.notice-row + .notice-row {
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.note-card {
  padding: 24rpx 28rpx !important;
  background: rgba(58, 175, 169, 0.035) !important;
  border: 1rpx solid rgba(58, 175, 169, 0.12) !important;
}

.user-note-content {
  font-size: 26rpx;
  line-height: 1.65;
  color: #1e293b;
  font-weight: 500;
  white-space: pre-wrap;
  word-break: break-all;
}

.blocked-card {
  border-color: rgba(220, 38, 38, 0.15) !important;
  background: rgba(220, 38, 38, 0.02) !important;
}

.notice-row.danger {
  color: #dc2626;
  font-weight: 700;
}

.notice-row.warning {
  color: #d97706;
  font-weight: 600;
}

/* Sleek, Single-Row Bottom Action Bar */
.bottom-actions {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  left: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 100;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.action-sub-btn {
  flex: 1;
  height: 80rpx !important;
  line-height: 80rpx !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  border-radius: 16rpx !important;
  background: var(--primary-light, #E8F8F5) !important;
  color: var(--primary-color, #3AAFA9) !important;
  border: 1rpx solid rgba(58, 175, 169, 0.18) !important;
  margin: 0 !important;
}

.action-main-btn {
  flex: 1.8;
  height: 80rpx !important;
  line-height: 80rpx !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  border-radius: 16rpx !important;
  background: var(--primary-color, #3AAFA9) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 16rpx rgba(58, 175, 169, 0.25) !important;
  margin: 0 !important;
}

.disabled-state-btn {
  width: 100% !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  text-align: center;
  border-radius: 16rpx !important;
  background: #f1f5f9 !important;
  color: #94a3b8 !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
}

/* Direct Complete Dialog */
.use-dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.use-dialog-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.use-dialog {
  width: 86vw;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 44rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  box-sizing: border-box;
}

.use-dialog-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary, #0f172a);
  text-align: center;
  margin-bottom: 28rpx;
}

.use-dialog-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.use-form-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  padding: 16rpx 0;
}

.use-form-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
}

.use-form-picker-val {
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 700;
}

.use-form-input {
  flex-grow: 1;
  font-size: 26rpx;
  color: #0f172a;
}

.use-dialog-actions {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.btn-renew {
  background: linear-gradient(135deg, #d97706, #f59e0b) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 14rpx rgba(217, 119, 6, 0.25) !important;
  border: none !important;
}
.btn-renew:active {
  background: #b45309 !important;
  transform: scale(0.97);
}
