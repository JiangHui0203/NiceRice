.edit-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 顶部智能识别与截图工作区 */
.smart-entry-section {
  margin-top: 16rpx;
}

.entry-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 16rpx;
}

.entry-card {
  background: #ffffff;
  border-radius: 18rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: var(--shadow-soft, 0 4rpx 16rpx rgba(0,0,0,0.02));
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin: 0;
  min-width: 0;
  padding: 20rpx 14rpx;
  text-align: left;
  line-height: 1;
}

.entry-card::after {
  border: none;
}

.entry-title {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
}

.entry-desc {
  color: #64748b;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
  margin-top: 8rpx;
}

.smart-import-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: var(--shadow-soft, 0 4rpx 16rpx rgba(0,0,0,0.02));
  padding: 20rpx 24rpx;
}

.smart-parse-box {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-bottom: 18rpx;
}

.smart-parse-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.smart-parse-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #0f172a;
}

.smart-parse-hint {
  font-size: 21rpx;
  color: #94a3b8;
  font-weight: 500;
}

.smart-parse-input {
  background: #f8fbfa;
  border: 1rpx solid rgba(62, 55, 45, 0.08);
  border-radius: 14rpx;
  box-sizing: border-box;
  color: #0f172a;
  font-size: 25rpx;
  height: 140rpx;
  line-height: 1.5;
  padding: 16rpx 18rpx;
  text-align: left;
  width: 100%;
}

.smart-parse-actions {
  display: flex;
  gap: 14rpx;
  justify-content: flex-end;
}

.parse-btn {
  background: #ddf7ef !important;
  border: 1rpx solid rgba(15, 118, 110, 0.18) !important;
  border-radius: 12rpx !important;
  color: #0f766e !important;
  font-size: 23rpx !important;
  font-weight: 800 !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  margin: 0 !important;
  padding: 0 24rpx !important;
}

.clear-btn {
  background: #f1f5f9 !important;
  border-radius: 12rpx !important;
  color: #64748b !important;
  font-size: 23rpx !important;
  font-weight: 700 !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  margin: 0 !important;
  padding: 0 24rpx !important;
}

/* 顶部紧凑型截图区域 */
.screenshot-strip-wrap {
  padding-top: 14rpx;
}

.screenshot-strip-wrap.with-top-border {
  border-top: 1rpx solid rgba(60, 60, 67, 0.07);
}

.screenshot-strip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.strip-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.strip-icon {
  font-size: 24rpx;
}

.strip-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #334155;
}

.strip-counter {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f766e;
}

.screenshot-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(3, 1fr);
}

.screenshot-thumb,
.screenshot-add {
  border-radius: 14rpx;
  height: 168rpx;
  min-width: 0;
  overflow: hidden;
  position: relative;
}

.screenshot-img {
  display: block;
  height: 100%;
  width: 100%;
}

.screenshot-remove {
  align-items: center;
  background: rgba(15, 23, 42, 0.75);
  border-radius: 50%;
  color: #ffffff;
  display: flex;
  font-size: 22rpx;
  font-weight: 900;
  height: 38rpx;
  justify-content: center;
  line-height: 1;
  margin: 0;
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 38rpx;
}

.screenshot-add {
  align-items: center;
  background: #f8fbfa;
  border: 1rpx dashed rgba(15, 118, 110, 0.35);
  color: #0f766e;
  display: flex;
  flex-direction: column;
  justify-content: center;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.screenshot-add::after {
  border: none;
}

.screenshot-add-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.screenshot-add-main {
  font-size: 23rpx;
  font-weight: 800;
}

/* 核心表单与网格化对齐系统 */
.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: var(--shadow-soft, 0 4rpx 16rpx rgba(0,0,0,0.02));
  overflow: hidden;
  padding: 0 28rpx;
}

.form-row {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 22rpx 0;
}

.form-row + .form-row {
  border-top: 1rpx solid rgba(60, 60, 67, 0.07);
}

/* 标准化标签列：统一 148rpx 宽度，彻底消除换行导致的参差不齐 */
.form-label {
  color: #475569;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
  width: 148rpx !important;
}

.form-input {
  color: #0f172a;
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  height: 64rpx;
  line-height: 64rpx;
  min-width: 0;
  text-align: right;
}

.form-picker {
  align-items: center;
  display: flex;
  flex: 1;
  height: 64rpx;
  justify-content: flex-end;
  min-width: 0;
}

.picker-value {
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 600;
  text-align: right;
}

.discount-preview-row {
  background: rgba(52, 199, 89, 0.05);
  border-radius: 12rpx;
  margin: 10rpx 0;
  padding: 14rpx 16rpx !important;
}

.discount-calc-badge {
  color: #16a34a;
  font-size: 24rpx;
  font-weight: 800;
}

.date-shortcuts-row {
  padding: 16rpx 0 20rpx !important;
}

.date-shortcut-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
  flex: 1;
}

.shortcut-chip {
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  color: #334155;
  font-size: 21rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  transition: all 0.15s ease;
}

.shortcut-chip:active {
  background: #cbd5e1;
  transform: scale(0.96);
}

/* 菜品明细与多行文本输入 */
.dishes-textarea,
.user-note-textarea {
  box-sizing: border-box;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.6;
  min-height: 140rpx;
  padding: 20rpx 0 10rpx;
  text-align: left !important;
  width: 100%;
}

.dishes-preview-wrap {
  background: rgba(58, 175, 169, 0.05);
  border: 1rpx solid rgba(58, 175, 169, 0.15);
  border-radius: 14rpx;
  margin: 12rpx 0 16rpx;
  padding: 16rpx;
}

.dishes-preview-title {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.dishes-preview-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.preview-chip {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid rgba(58, 175, 169, 0.2);
  border-radius: 10rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.02);
  display: inline-flex;
  gap: 8rpx;
  padding: 8rpx 14rpx;
}

.chip-dot {
  background: #3aafa9;
  border-radius: 50%;
  flex-shrink: 0;
  height: 10rpx;
  width: 10rpx;
}

.chip-name {
  color: #1e293b;
  font-size: 24rpx;
  font-weight: 700;
}

.chip-count {
  background: rgba(58, 175, 169, 0.12);
  border-radius: 6rpx;
  color: #0f766e;
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 800;
  padding: 2rpx 8rpx;
}

.quick-pills-row {
  align-items: center;
  border-top: 1rpx solid rgba(60, 60, 67, 0.07);
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0 20rpx;
}

.quick-pills-label {
  color: #64748b;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
}

.quick-pills-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.quick-pill-item {
  align-items: center;
  background: rgba(15, 118, 110, 0.08);
  border: 1rpx solid rgba(15, 118, 110, 0.18);
  border-radius: 12rpx;
  display: inline-flex;
  gap: 6rpx;
  margin-right: 10rpx;
  padding: 6rpx 14rpx;
  transition: all 0.15s ease;
}

.quick-pill-item:active {
  background: rgba(15, 118, 110, 0.16);
  transform: scale(0.95);
}

.quick-pill-text {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.quick-pill-item.rule-pill {
  background: rgba(245, 158, 11, 0.08);
  border-color: rgba(245, 158, 11, 0.2);
}

.quick-pill-item.rule-pill .quick-pill-text {
  color: #b45309;
}

/* 标签与生活偏好卡片 */
.tag-form-card {
  padding: 24rpx 28rpx !important;
}

.tag-preview {
  padding: 0;
}

.tag-helper {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
  margin-bottom: 18rpx;
}

.life-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.life-chip {
  background: #f1f5f9;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  padding: 14rpx 18rpx;
  transition: all 0.15s ease;
}

.life-chip.active {
  background: #ddf7ef;
  border-color: rgba(46, 111, 99, 0.24);
  color: #0f766e;
}

.custom-tag-row {
  align-items: center;
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.07);
}

.custom-tag-input {
  background: #f8fbfa;
  border: 1rpx solid rgba(62, 55, 45, 0.08);
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #0f172a;
  flex: 1;
  font-size: 25rpx;
  height: 68rpx;
  min-width: 0;
  padding: 0 18rpx;
}

.custom-tag-btn {
  align-items: center;
  background: #0f766e;
  border-radius: 12rpx;
  color: #ffffff;
  display: flex;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  height: 68rpx;
  justify-content: center;
  margin: 0;
  width: 104rpx;
}

/* 地点与定位卡片 */
.location-panel {
  align-items: center;
  background: linear-gradient(135deg, #edf8f4 0%, #f8fbf9 100%);
  border: 1rpx solid rgba(22, 138, 115, 0.14);
  border-radius: 16rpx;
  display: flex;
  gap: 18rpx;
  margin: 20rpx 0 10rpx;
  padding: 20rpx;
}

.location-main {
  flex: 1;
  min-width: 0;
}

.location-title {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.location-desc {
  color: #1f2933;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
  margin-top: 8rpx;
  word-break: break-all;
}

.location-side {
  align-items: flex-end;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  gap: 12rpx;
}

.location-badge {
  background: #ffffff;
  border: 1rpx solid rgba(22, 138, 115, 0.18);
  border-radius: 999rpx;
  color: #0f766e;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  padding: 8rpx 14rpx;
  white-space: nowrap;
}

.location-btn {
  align-items: center;
  background: #0f766e;
  border-radius: 12rpx;
  color: #ffffff;
  display: flex;
  font-size: 24rpx;
  font-weight: 800;
  height: 60rpx;
  justify-content: center;
  line-height: 1;
  margin: 0;
  padding: 0 20rpx;
}

.route-row {
  gap: 14rpx;
}

.route-input {
  min-width: 0;
}

.route-estimate-btn {
  align-items: center;
  background: #ddf7ef;
  border: 1rpx solid rgba(22, 138, 115, 0.18);
  border-radius: 12rpx;
  color: #0f766e;
  display: flex;
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 800;
  height: 60rpx;
  justify-content: center;
  line-height: 1;
  margin: 0;
  padding: 0 20rpx;
}

.route-origin-row {
  align-items: center;
  background: #f3fbf8;
  border-radius: 12rpx;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin: 0 0 16rpx 0;
  padding: 14rpx 18rpx;
}

.route-origin-desc {
  color: #0f766e;
  flex: 1;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  min-width: 0;
  text-align: right;
}

/* 补充规则多行输入 */
.note-row {
  align-items: flex-start;
  padding: 22rpx 0;
}

.note-row .form-textarea {
  box-sizing: border-box;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.5;
  min-height: 80rpx;
  padding: 0;
  text-align: right;
}

/* 底部吸底保存栏与居中按钮 */
.bottom-bar {
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  bottom: 0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  left: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 100;
}

.save-btn {
  align-items: center !important;
  background: var(--primary-color, #3aafa9) !important;
  border-radius: 18rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(58, 175, 169, 0.28) !important;
  color: #ffffff !important;
  display: flex !important;
  font-size: 30rpx !important;
  font-weight: 800 !important;
  height: 88rpx !important;
  justify-content: center !important;
  line-height: 1 !important;
  margin: 0 auto !important;
  padding: 0 !important;
  text-align: center !important;
  width: 100% !important;
}
