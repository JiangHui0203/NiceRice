/* ========================================================== */
/* 对比栏增强与约局候选卡分享抽屉样式                         */
/* ========================================================== */

.compare-floating-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.compare-share-btn {
  height: 68rpx !important;
  font-size: 24rpx !important;
  font-weight: 800 !important;
  border-radius: 34rpx !important;
  padding: 0 24rpx !important;
  background: rgba(13, 148, 136, 0.08) !important;
  color: #0d9488 !important;
  border: 1rpx solid rgba(13, 148, 136, 0.2) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 !important;
}

.compare-share-btn:disabled {
  opacity: 0.45;
  background: rgba(0, 0, 0, 0.04) !important;
  color: #94a3b8 !important;
  border-color: transparent !important;
}

.compare-header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.compare-share-pill {
  font-size: 22rpx;
  color: #0d9488;
  font-weight: 800;
  background: rgba(13, 148, 136, 0.08);
  border: 1rpx solid rgba(13, 148, 136, 0.2);
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.compare-share-pill:active {
  background: rgba(13, 148, 136, 0.18);
  transform: scale(0.96);
}

/* 约局候选卡全屏半透明遮罩与抽屉 */
.share-candidate-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 120;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.share-candidate-mask.visible {
  visibility: visible;
  opacity: 1;
}

.share-candidate-drawer {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  max-height: 82vh;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.12);
}

.share-candidate-mask.visible .share-candidate-drawer {
  transform: translateY(0);
}

/* 抽屉头部：标题、统计胶囊与关闭按钮整洁排布，避免重叠 */
.share-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.share-drawer-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.share-drawer-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.share-drawer-title {
  font-size: 30rpx;
  font-weight: 850;
  color: #1e293b;
  line-height: 1.2;
}

.share-drawer-count-badge {
  font-size: 20rpx;
  font-weight: 800;
  color: #0d9488;
  background: rgba(13, 148, 136, 0.1);
  border: 1rpx solid rgba(13, 148, 136, 0.2);
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.share-drawer-subtitle {
  font-size: 21rpx;
  color: #64748b;
  font-weight: 500;
  line-height: 1.3;
}

.share-drawer-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  color: #64748b;
  flex-shrink: 0;
  margin-left: 16rpx;
  transition: all 0.2s ease;
}

.share-drawer-close:active {
  background: #e2e8f0;
  transform: scale(0.92);
}

.share-candidate-scroll {
  max-height: 52vh;
  margin-bottom: 20rpx;
  padding: 2rpx 2rpx;
  box-sizing: border-box;
}

.share-candidate-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #f8fafc;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.share-candidate-card:last-child {
  margin-bottom: 0;
}

.share-candidate-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #0d9488, #14b8a6);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(13, 148, 136, 0.2);
}

.share-candidate-body {
  flex: 1;
  min-width: 0;
}

.share-candidate-name {
  font-size: 26rpx;
  font-weight: 850;
  color: #1e293b;
  line-height: 1.35;
  margin-bottom: 4rpx;
}

.share-candidate-venue {
  font-size: 21rpx;
  color: #64748b;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.share-candidate-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: #0d9488;
  margin-bottom: 8rpx;
}

.share-meta-original {
  font-size: 18rpx;
  color: #94a3b8;
  text-decoration: line-through;
}

.share-meta-sep {
  color: #cbd5e1;
  font-size: 18rpx;
}

.share-candidate-dishes {
  font-size: 21rpx;
  color: #475569;
  font-weight: 600;
  line-height: 1.4;
  background: rgba(13, 148, 136, 0.04);
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(13, 148, 136, 0.08);
}

.share-drawer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.share-action-btn {
  flex: 1;
  height: 80rpx !important;
  border-radius: 40rpx !important;
  font-size: 25rpx !important;
  font-weight: 850 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
}

.share-action-copy {
  background: rgba(13, 148, 136, 0.08) !important;
  color: #0d9488 !important;
  border: 1rpx solid rgba(13, 148, 136, 0.2) !important;
}

.share-action-send {
  background: #0d9488 !important;
  color: #ffffff !important;
  box-shadow: 0 6rpx 20rpx rgba(13, 148, 136, 0.25) !important;
  border: none !important;
}

/* 顶部好友分享模式横幅 */
.shared-view-banner {
  background: linear-gradient(135deg, rgba(58, 175, 169, 0.12), rgba(58, 175, 169, 0.04));
  border: 1.5rpx solid rgba(58, 175, 169, 0.28);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin: 10rpx 24rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(58, 175, 169, 0.08);
}

.shared-banner-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.shared-banner-icon {
  font-size: 34rpx;
  line-height: 1;
}

.shared-banner-texts {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.shared-banner-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shared-banner-sub {
  font-size: 21rpx;
  color: #0f766e;
  font-weight: 600;
}

.shared-banner-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.shared-save-btn {
  height: 60rpx !important;
  line-height: 60rpx !important;
  font-size: 23rpx !important;
  font-weight: 800 !important;
  background: var(--primary-color, #3AAFA9) !important;
  color: #ffffff !important;
  border-radius: 30rpx !important;
  padding: 0 20rpx !important;
  margin: 0 !important;
  box-shadow: 0 4rpx 12rpx rgba(58, 175, 169, 0.25) !important;
  border: none !important;
}

.shared-exit-btn {
  height: 60rpx !important;
  line-height: 60rpx !important;
  font-size: 22rpx !important;
  font-weight: 600 !important;
  background: #f1f5f9 !important;
  color: #64748b !important;
  border-radius: 30rpx !important;
  padding: 0 16rpx !important;
  margin: 0 !important;
  border: 1rpx solid rgba(0, 0, 0, 0.06) !important;
}

.btn-renew {
  background: linear-gradient(135deg, #d97706, #f59e0b) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 14rpx rgba(217, 119, 6, 0.25) !important;
  border: none !important;
}
.btn-renew:active {
  background: #b45309 !important;
  transform: scale(0.97);
}

