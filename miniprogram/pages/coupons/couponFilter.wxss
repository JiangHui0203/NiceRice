/* ==========================================================================
   Coupon Filter, Search Bar & Sorting Toolbar Styles
   ========================================================================== */

/* 搜索框 */
.search-box-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  margin-top: 16rpx;
  background: #ffffff;
  border-radius: var(--radius-md, 20rpx);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: var(--shadow-soft, 0 4rpx 20rpx rgba(0, 0, 0, 0.02));
}

.search-icon-symbol {
  font-size: 28rpx;
  color: var(--text-muted, #94a3b8);
  flex-shrink: 0;
  line-height: 1;
}

.search-input-field {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary, #0f172a);
  height: 48rpx;
  line-height: 48rpx;
}

.search-clear-symbol {
  font-size: 26rpx;
  color: var(--text-muted, #94a3b8);
  padding: 8rpx;
  line-height: 1;
  flex-shrink: 0;
}

/* 状态分段标签栏（全部/待安排/已安排/已过期/已使用） */
.status-segmented-bar {
  display: flex;
  align-items: center;
  background: rgba(118, 118, 128, 0.08);
  padding: 6rpx 8rpx;
  border-radius: var(--radius-md, 16rpx);
  margin-top: 18rpx;
  gap: 4rpx;
  box-sizing: border-box;
}

.status-seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 12rpx;
  transition: all 0.2s ease;
  white-space: nowrap;
  box-sizing: border-box;
}

.status-seg-item.active {
  background: #ffffff;
  color: #0f172a;
  font-weight: 800;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.seg-num {
  font-size: 19rpx;
  margin-left: 4rpx;
  font-weight: 700;
  opacity: 0.85;
  line-height: 1;
  display: inline-block;
}

/* 排序与筛选快捷工具条 */
.coupon-toolbar {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 6rpx 8rpx;
  background: rgba(58, 175, 169, 0.04);
  border-radius: var(--radius-md, 16rpx);
  gap: 8rpx;
}

.sort-row-static {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 6rpx;
}

.sort-tab {
  flex: 1;
  align-items: center;
  border-radius: 12rpx;
  color: var(--text-secondary, #475569);
  display: inline-flex;
  font-size: 23rpx;
  font-weight: 600;
  height: 54rpx;
  line-height: 54rpx;
  justify-content: center;
  padding: 0 4rpx;
  transition: var(--transition-normal, all 0.2s ease);
  white-space: nowrap;
}

.sort-tab.active {
  background: #ffffff;
  color: var(--primary-color, #3aafa9);
  box-shadow: 0 2rpx 8rpx rgba(58, 175, 169, 0.08);
  font-weight: 700;
}

.sort-sub-text {
  font-size: 20rpx;
  margin-left: 2rpx;
  font-weight: 700;
}

.filter-entry {
  align-items: center;
  background: transparent;
  border-left: 1rpx solid rgba(60, 60, 67, 0.12);
  display: flex;
  flex-shrink: 0;
  height: 54rpx;
  justify-content: center;
  gap: 6rpx;
  padding-left: 16rpx;
  padding-right: 8rpx;
  min-width: 136rpx;
  box-sizing: border-box;
  transition: var(--transition-normal, all 0.2s ease);
}

.filter-entry-title {
  color: var(--primary-color, #3aafa9);
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-entry-summary {
  color: var(--text-secondary, #64748b);
  font-size: 20rpx;
  width: 68rpx;
  min-width: 68rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.filter-entry.active .filter-entry-title,
.filter-entry.active .filter-entry-summary {
  color: var(--primary-color, #3aafa9);
  font-weight: 800;
}

/* 翡翠绿高质感优惠券空状态图标 */
.emerald-ticket-badge {
  width: 140rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #3aafa9 0%, #2b7a78 100%);
  border-radius: 12rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-weight: 800;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 18rpx rgba(58, 175, 169, 0.25);
  margin: 0 auto 24rpx auto;
}

/* 原生 page-container 内联半屏抽屉筛选面板（恰到好处的 20rpx 黄金微距与紧凑排版） */
.filter-panel-drawer {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  padding: 14rpx 20rpx 16rpx 20rpx;
  background: #ffffff;
}

.drawer-drag-handle {
  width: 48rpx;
  height: 6rpx;
  background: #e2e8f0;
  border-radius: 3rpx;
  margin: 0 auto 10rpx;
}

.filter-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.filter-panel-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary, #0f172a);
}

.filter-reset {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--primary-color, #3aafa9);
  padding: 2rpx 4rpx;
}

.filter-group {
  margin-bottom: 10rpx;
}

.filter-label {
  font-size: 21rpx;
  font-weight: 700;
  color: var(--text-secondary, #64748b);
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

/* 3 列等宽规整紧凑网格 */
.filter-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.filter-chip {
  height: 52rpx;
  line-height: 50rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-secondary, #475569);
  background: #f8fafc;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-chip.active {
  background: var(--primary-color, #3aafa9);
  color: #ffffff;
  font-weight: 750;
  border-color: var(--primary-color, #3aafa9);
  box-shadow: 0 2rpx 6rpx rgba(58, 175, 169, 0.25);
}

/* 底部完成按钮 */
.filter-done-btn {
  width: 100% !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  border-radius: 16rpx !important;
  font-size: 27rpx !important;
  font-weight: 800 !important;
  background: linear-gradient(135deg, #3aafa9 0%, #2b7a78 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 12rpx rgba(58, 175, 169, 0.3) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  margin: 12rpx 0 0 0 !important;
}
