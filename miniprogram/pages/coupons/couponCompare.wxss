/* ==========================================================================
   Coupon Comparison & Batch Management Styles
   ========================================================================== */

/* Compare Mode Styling */
.coupon-card.compare-mode {
  padding-left: 92rpx !important;
}

.compare-checkbox {
  position: absolute;
  left: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  animation: fadeIn 0.25s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-50%) scale(0.8); }
  to { opacity: 1; transform: translateY(-50%) scale(1); }
}

.checkbox-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(58, 175, 169, 0.3);
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
  box-sizing: border-box;
}

.checkbox-circle.checked {
  background: var(--primary-color, #3aafa9);
  border-color: var(--primary-color, #3aafa9);
  box-shadow: 0 4rpx 10rpx rgba(58, 175, 169, 0.25);
}

.checkbox-circle text {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  line-height: 1;
}

.coupon-card.compare-checked {
  border-color: var(--primary-color, #3aafa9) !important;
  box-shadow: 0 12rpx 28rpx rgba(58, 175, 169, 0.06) !important;
}

/* Bottom compare floating bar */
.compare-floating-bar {
  position: fixed;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  left: 30rpx;
  right: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(58, 175, 169, 0.08);
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 99;
  transform: translateY(200rpx);
  opacity: 0;
  transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.4s ease;
  pointer-events: none;
}

.compare-floating-bar.visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.compare-floating-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.compare-floating-title {
  color: var(--primary-color, #3aafa9);
  font-size: 26rpx;
  font-weight: 700;
}

.compare-floating-desc {
  color: var(--text-muted, #94a3b8);
  font-size: 22rpx;
}

.compare-start-btn {
  height: 76rpx;
  border-radius: var(--radius-md, 16rpx);
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  margin: 0;
  background: var(--primary-color, #3aafa9) !important;
  color: #ffffff !important;
  border: none;
}

.compare-start-btn[disabled] {
  background: rgba(60, 60, 67, 0.12) !important;
  color: var(--text-muted, #94a3b8) !important;
  opacity: 0.6;
}

/* Compare Matrix Drawer Mask */
.compare-drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
}

.compare-drawer-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.compare-drawer-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 85vh;
  background: #ffffff;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 40rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  display: flex;
  flex-direction: column;
}

.compare-drawer-mask.visible .compare-drawer-content {
  transform: translateY(0);
}

.compare-drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 44rpx 30rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}

.compare-drawer-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary, #0f172a);
}

.compare-drawer-close {
  font-size: 36rpx;
  color: var(--text-muted, #94a3b8);
  padding: 10rpx;
  line-height: 1;
}

.compare-matrix-scroll {
  flex: 1;
  width: 100%;
  overflow: auto;
  box-sizing: border-box;
  padding: 28rpx 44rpx;
}

.compare-matrix-table {
  display: flex;
  width: fit-content;
  min-width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--border-color, #e2e8f0);
}

.compare-column {
  display: flex;
  flex-direction: column;
  width: 210rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-right: 1rpx solid rgba(60, 60, 67, 0.06);
}

.compare-column.labels {
  width: 180rpx;
  background: rgba(58, 175, 169, 0.02);
  font-weight: 700;
  position: sticky;
  left: 0;
  z-index: 2;
}

.compare-column:last-child {
  border-right: none;
}

.compare-cell {
  height: 100rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary, #475569);
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.06);
  text-align: center;
  box-sizing: border-box;
}

.compare-cell:last-child {
  border-bottom: none;
}

.compare-cell.header-cell {
  height: 140rpx;
  background: rgba(15, 118, 110, 0.04);
  font-weight: 700;
  color: var(--primary-color, #0f766e);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.compare-column.item-col.theme-0 .compare-cell.header-cell {
  background: var(--trio-0-bg-light);
  color: var(--trio-0-text);
}

.compare-column.item-col.theme-1 .compare-cell.header-cell {
  background: var(--trio-1-bg-light);
  color: var(--trio-1-text);
}

.compare-column.item-col.theme-2 .compare-cell.header-cell {
  background: var(--trio-2-bg-light);
  color: var(--trio-2-text);
}

.compare-column.labels .compare-cell.header-cell {
  background: var(--trio-0-bg-light);
  font-weight: 700;
  color: var(--trio-0-text);
}

.compare-item-venue {
  font-size: 18rpx;
  color: var(--text-muted, #94a3b8);
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.compare-item-title {
  font-size: 24rpx;
  max-height: 72rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.25;
}

.compare-cell.price-val {
  color: #dc2626;
  font-weight: 700;
  font-size: 28rpx;
}

.compare-cell.score-val {
  color: #16a34a;
  font-weight: 700;
  font-size: 28rpx;
}

.compare-cell.highlight-val {
  color: var(--accent-color, #d99c52);
  font-weight: 700;
}

.compare-cell.desc-cell {
  height: 160rpx;
  font-size: 22rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
}

.compare-cell.dishes-cell {
  height: 180rpx;
  font-size: 22rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  padding: 12rpx 16rpx;
  color: var(--text-secondary, #475569);
}

.compare-column.labels .compare-cell.dishes-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: var(--text-primary, #0f172a);
}

.compare-cell.action-cell {
  height: 120rpx;
}

.compare-cell.action-cell .btn {
  width: 100% !important;
  font-size: 22rpx;
  height: 64rpx;
  border-radius: 12rpx;
  padding: 0;
  font-weight: 700;
  margin: 0;
}

/* Batch Floating Bar */
.coupon-card.batch-mode {
  position: relative;
  padding-left: 80rpx;
  transition: all 0.25s ease;
}

.coupon-card.batch-checked {
  border-color: #34c759;
  background: rgba(52, 199, 89, 0.04);
}

.batch-checkbox {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
}

.batch-checkbox .checkbox-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2.5rpx solid #cbd5e1;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.batch-checkbox .checkbox-circle.checked {
  background: #34c759;
  border-color: #34c759;
}

/* ========================================================== */
/* 底部批量操作悬浮条 (采用现代弹性自适应浮动胶囊)           */
/* ========================================================== */

.batch-floating-bar {
  position: fixed;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.12);
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  transform: translateY(200rpx);
  opacity: 0;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  z-index: 100;
  box-sizing: border-box;
  pointer-events: none;
}

.batch-floating-bar.visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.batch-floating-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  min-width: 100rpx;
  gap: 4rpx;
}

.batch-floating-title {
  font-size: 25rpx;
  font-weight: 850;
  color: #1e293b;
  white-space: nowrap;
}

.batch-quick-links {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: var(--primary-color, #3AAFA9);
  font-weight: 700;
  white-space: nowrap;
}

.batch-link {
  padding: 2rpx 0;
}

.batch-link-sep {
  color: #cbd5e1;
  font-size: 18rpx;
}

.batch-floating-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  justify-content: flex-end;
  min-width: 0;
}

.batch-action-btn {
  flex: 1;
  min-width: 0;
  height: 68rpx !important;
  line-height: 68rpx !important;
  font-size: 23rpx !important;
  padding: 0 8rpx !important;
  border-radius: 34rpx !important;
  font-weight: 750 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 !important;
  white-space: nowrap !important;
  box-sizing: border-box !important;
}

.batch-action-btn.btn-share {
  background: var(--primary-color, #3AAFA9) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 14rpx rgba(58, 175, 169, 0.25) !important;
  border: none !important;
}

.batch-action-btn.btn-secondary {
  background: #f1f5f9 !important;
  color: #334155 !important;
  border: 1rpx solid rgba(0, 0, 0, 0.06) !important;
}

.batch-action-btn.btn-danger {
  background: #fee2e2 !important;
  color: #dc2626 !important;
  border: 1rpx solid rgba(220, 38, 38, 0.15) !important;
}

.batch-action-btn[disabled] {
  opacity: 0.4 !important;
  box-shadow: none !important;
}

.btn-share {
  background: #0d9488 !important;
  color: #ffffff !important;
  border: none !important;
}

.btn-share[disabled] {
  background: #99d5d1 !important;
  color: rgba(255, 255, 255, 0.7) !important;
}
