.container {
  padding: var(--page-padding-v, 24rpx) var(--page-padding-h, 28rpx) 180rpx;
  background-color: var(--bg-color, #f4f7f7);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 1. Header Card */
.header-card {
  padding: 24rpx 24rpx;
  background: #ffffff;
  border-radius: var(--card-radius, 20rpx);
  border: 1rpx solid rgba(13, 148, 136, 0.08);
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(13, 148, 136, 0.02);
  box-sizing: border-box;
}

.header-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  font-size: 32rpx;
  font-weight: 850;
  color: #1e293b;
}

.header-desc {
  font-size: 22rpx;
  line-height: 1.4;
  color: #64748b;
  margin-top: 8rpx;
}

.header-share-pill-btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 8rpx 20rpx !important;
  background: rgba(13, 148, 136, 0.08) !important;
  color: #0d9488 !important;
  border: 1rpx solid rgba(13, 148, 136, 0.2) !important;
  font-size: 22rpx !important;
  font-weight: 800 !important;
  border-radius: 30rpx !important;
  margin: 0 !important;
  min-height: 0 !important;
  line-height: 1.2 !important;
  width: auto !important;
}

.header-share-pill-btn:active {
  background: rgba(13, 148, 136, 0.18) !important;
  transform: scale(0.96);
}

/* 2. Global Section Styling */
.section {
  margin-bottom: 40rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1e293b;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  background-color: #0f766e;
  border-radius: 4rpx;
}

/* 3. Friend Scroll Selector */
.friend-scroll {
  white-space: nowrap;
  width: 100%;
}

.friend-list {
  display: flex;
  padding: 8rpx 0;
  gap: 16rpx;
}

.friend-tag {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #ffffff;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
  border: 2rpx solid #e2e8f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.01);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.friend-tag.active.theme-color-0 {
  background: var(--trio-0-bg-light) !important;
  color: var(--trio-0-text) !important;
  border-color: var(--trio-0-border) !important;
  box-shadow: 0 4rpx 12rpx rgba(15, 118, 110, 0.08) !important;
}

.friend-tag.active.theme-color-1 {
  background: var(--trio-1-bg-light) !important;
  color: var(--trio-1-text) !important;
  border-color: var(--trio-1-border) !important;
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.08) !important;
}

.friend-tag.active.theme-color-2 {
  background: var(--trio-2-bg-light) !important;
  color: var(--trio-2-text) !important;
  border-color: var(--trio-2-border) !important;
  box-shadow: 0 4rpx 12rpx rgba(82, 120, 158, 0.08) !important;
}

.friend-check {
  margin-right: 8rpx;
  font-weight: bold;
}

.friend-warn-dot {
  width: 10rpx;
  height: 10rpx;
  background-color: #ff9500;
  border-radius: 50%;
  margin-left: 8rpx;
}

/* 4. Detail list & Panel */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

.details-card {
  padding: 30rpx;
}

.details-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #475569;
  margin-bottom: 20rpx;
}

.details-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-friend-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-indicator {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.status-indicator.available {
  background-color: #dcfce7;
  color: #16a34a;
}

.status-indicator.busy {
  background-color: #fee2e2;
  color: #dc2626;
}

.detail-friend-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}

.detail-friend-desc {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 700;
}

/* 5. Coupons list */
.coupons-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.coupon-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  position: relative;
}

.coupon-left {
  flex: 1;
  padding-right: 20rpx;
}

.coupon-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.coupon-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1e293b;
  line-height: 1.3;
}

.coupon-badge {
  font-size: 18rpx;
  font-weight: 850;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.coupon-badge.urgent {
  background-color: #fee2e2;
  color: #dc2626;
}

.coupon-badge.priority {
  background-color: #fff3c7;
  color: #d97706;
}

.coupon-badge.ready {
  background-color: #ccfbf1;
  color: #0f766e;
}

.coupon-merchant {
  font-size: 22rpx;
  color: #475569;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.coupon-expiry {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 700;
}

.coupon-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.coupon-price-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price-val {
  font-size: 32rpx;
  font-weight: 850;
  color: #0f766e;
}

.price-original {
  font-size: 20rpx;
  color: #94a3b8;
  text-decoration: line-through;
}

.btn-create-plan {
  background-color: #0f766e;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  margin: 0;
  line-height: 1.4;
}

.btn-create-plan::after {
  border: none;
}

/* 6. Empty State card */
.empty-coupons-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  font-weight: 800;
  color: #475569;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 700;
  line-height: 1.4;
}

/* 底部固定操作栏（与小程序全局按钮一致） */
.heatmap-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 90;
}

.heatmap-action-btn {
  flex: 1;
  height: 76rpx !important;
  line-height: 74rpx !important;
  border-radius: 38rpx !important;
  font-size: 25rpx !important;
  font-weight: 850 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 !important;
  padding: 0 10rpx !important;
  box-sizing: border-box;
  background: rgba(13, 148, 136, 0.08) !important;
  color: #0d9488 !important;
  border: 1rpx solid rgba(13, 148, 136, 0.2) !important;
  transition: all 0.2s ease;
}

.heatmap-action-btn:active {
  background: rgba(13, 148, 136, 0.18) !important;
  transform: scale(0.96);
}

