/* ========================================================== */
/* 时段活动档案与协同计划面板交互样式                         */
/* ========================================================== */

.heatmap-slot-section {
  margin-top: 28rpx;
  animation: fadeIn 0.3s ease;
}

.slot-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.slot-head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.slot-title {
  font-size: 29rpx;
  font-weight: 850;
  color: #1e293b;
}

.slot-time-pill {
  font-size: 21rpx;
  font-weight: 700;
  color: #0d9488;
  background: rgba(13, 148, 136, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(13, 148, 136, 0.16);
}

.slot-overlap-badge {
  font-size: 21rpx;
  font-weight: 750;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.slot-overlap-badge.full {
  background: #dcfce7;
  color: #15803d;
  border: 1rpx solid rgba(21, 128, 61, 0.2);
}

.slot-overlap-badge.partial {
  background: #fef9c3;
  color: #a16207;
  border: 1rpx solid rgba(161, 98, 7, 0.2);
}

.slot-overlap-badge.none {
  background: #f1f5f9;
  color: #64748b;
  border: 1rpx solid rgba(100, 116, 139, 0.15);
}

/* 已锁定计划展示卡 */
.slot-plan-card {
  background: linear-gradient(135deg, rgba(13, 148, 136, 0.08) 0%, #ffffff 100%);
  border: 1.5rpx solid rgba(13, 148, 136, 0.28);
  border-left: 8rpx solid #0d9488;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
}

.slot-plan-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: #0d9488;
  margin-bottom: 6rpx;
}

.slot-plan-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.slot-plan-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: #475569;
  margin-bottom: 8rpx;
}

.slot-plan-venue {
  font-weight: 600;
}

.slot-plan-price {
  font-weight: 800;
  color: #0d9488;
}

.slot-plan-dishes {
  font-size: 21rpx;
  color: #64748b;
  background: rgba(0, 0, 0, 0.03);
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 6rpx;
}

.slot-plan-note {
  font-size: 20rpx;
  color: #94a3b8;
}

/* 推荐方案卡片 */
