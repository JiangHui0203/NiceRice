/* ========================================================== */
/* 渐进蓄力加速绽放动效 (前慢后快纯净贝塞尔曲线 极致丝滑)       */
/* ========================================================== */

.slot-detail-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1200;
  opacity: 0;
  visibility: hidden;
  will-change: opacity, visibility;
  transition: opacity 0.22s linear, visibility 0.22s;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
}

.slot-detail-modal-mask.show {
  opacity: 1;
  visibility: visible;
}

.slot-detail-modal-card {
  width: 100%;
  max-width: 680rpx;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1.5rpx solid rgba(13, 148, 136, 0.35);
  position: relative;
  will-change: transform, opacity;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  transform: translate3d(var(--origin-delta-x, 0px), var(--origin-delta-y, 0px), 0) scale(0.08);
  -webkit-transform: translate3d(var(--origin-delta-x, 0px), var(--origin-delta-y, 0px), 0) scale(0.08);
  opacity: 0;
  contain: layout style paint;
}

.slot-detail-modal-mask.show .slot-detail-modal-card {
  animation: progressiveContinuousBloom 0.42s cubic-bezier(0.5, 0.05, 0.12, 1) forwards;
  -webkit-animation: progressiveContinuousBloom 0.42s cubic-bezier(0.5, 0.05, 0.12, 1) forwards;
}

@keyframes progressiveContinuousBloom {
  0% {
    opacity: 0.12;
    transform: translate3d(var(--origin-delta-x, 0px), var(--origin-delta-y, 0px), 0) scale(0.08);
  }
  100% {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@-webkit-keyframes progressiveContinuousBloom {
  0% {
    opacity: 0.12;
    -webkit-transform: translate3d(var(--origin-delta-x, 0px), var(--origin-delta-y, 0px), 0) scale(0.08);
  }
  100% {
    opacity: 1;
    -webkit-transform: translate3d(0, 0, 0) scale(1);
  }
}
