/* pages/plan-confirm/index.wxss */
.confirm-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.confirm-hero {
  background: #ffffff;
  padding: 36rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}

.confirm-type {
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
}

.confirm-title {
  color: var(--text-primary);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-top: 16rpx;
}

.confirm-meta {
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.45;
  margin-top: 10rpx;
}

.confirm-score {
  background: rgba(22, 163, 74, 0.06);
  border-radius: 12rpx;
  color: #16a34a;
  display: inline-flex;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  margin-top: 18rpx;
  padding: 10rpx 14rpx;
}

.selected-time {
  align-items: center;
  background: var(--primary-light);
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx;
}

.selected-label {
  color: var(--primary-color);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.selected-date {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-top: 6rpx;
}

.selected-range {
  color: var(--primary-color);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.25;
}

.time-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.info-card {
  overflow: hidden;
  padding: 8rpx 28rpx;
}

.info-row {
  align-items: flex-start;
  display: flex;
  gap: 24rpx;
  justify-content: space-between;
  padding: 24rpx 0;
}

.info-row + .info-row,
.reminder-row + .reminder-row {
  border-top: 1rpx solid rgba(60, 60, 67, 0.06);
}

.info-label {
  color: var(--text-muted);
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.45;
  width: 92rpx;
}

.info-value {
  color: var(--text-primary);
  flex: 1;
  font-size: 25rpx;
  line-height: 1.45;
  text-align: right;
}

.reminder-card {
  padding: 8rpx 28rpx;
}

.reminder-row {
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.55;
  padding: 20rpx 0;
}

.bottom-actions {
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
  bottom: 0;
  box-sizing: border-box;
  display: grid;
  gap: 16rpx;
  grid-template-columns: 1fr;
  left: 0;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 100;
}

.action-main {
  height: 88rpx !important;
}

.action-sub {
  width: 100% !important;
  height: 80rpx !important;
}

.picker-value-link {
  color: var(--primary-color);
  font-weight: 700;
  text-decoration: none;
}

/* Custom Time Toggle & Picker Panel */
.custom-time-toggle {
  margin-top: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1.5rpx solid rgba(60, 60, 67, 0.08);
  transition: all 0.25s ease;
}

.custom-time-toggle.active {
  border-color: #0f766e;
  background: rgba(15, 118, 110, 0.04);
}

.custom-toggle-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.custom-toggle-icon {
  font-size: 32rpx;
}

.custom-toggle-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.custom-toggle-desc {
  font-size: 21rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.custom-toggle-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f766e;
  background: rgba(15, 118, 110, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 99rpx;
}

.custom-time-picker-panel {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.custom-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
}

.picker-val-chip {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f766e;
  background: #ffffff;
  border: 1rpx solid #cbd5e1;
  padding: 8rpx 24rpx;
  border-radius: 12rpx;
}

.custom-eval-box {
  margin-top: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #cbd5e1;
}

.eval-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eval-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #0f766e;
}

.eval-score {
  font-size: 22rpx;
  font-weight: 700;
  color: #16a34a;
}

.eval-desc {
  font-size: 21rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.eval-warnings {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.eval-warn {
  font-size: 20rpx;
  color: #dc2626;
  font-weight: 600;
}

