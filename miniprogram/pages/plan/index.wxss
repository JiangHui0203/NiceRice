/* pages/plan/index.wxss */
.summary-row {
  display: grid;
  gap: 20rpx;
  grid-template-columns: repeat(3, 1fr);
}

.summary-card {
  padding: 24rpx 16rpx;
  text-align: center;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.summary-value {
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.1;
}

.summary-label {
  color: #64748b;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.3;
  margin-top: 6rpx;
}

.wheel-entry {
  align-items: center;
  background: #ffffff;
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: var(--transition-normal);
}

.wheel-entry:active {
  transform: scale(0.985);
  box-shadow: var(--shadow-hover);
}

.wheel-visual-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(13, 148, 136, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.mini-wheel-disc {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  position: relative;
  background: conic-gradient(
    #3aafa9 0deg 90deg,
    #f59e0b 90deg 180deg,
    #2b7a78 180deg 270deg,
    #17252a 270deg 360deg
  );
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: wheel-idle-spin 16s linear infinite;
}

@keyframes wheel-idle-spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.mini-wheel-center {
  width: 16rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25);
  z-index: 2;
}

.mini-wheel-pointer {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 12rpx solid #3aafa9;
  z-index: 10;
}

/* 好友热力图微缩视觉徽章 */
.heatmap-visual-badge {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(13, 148, 136, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mini-heatmap-grid {
  width: 44rpx;
  height: 44rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4rpx;
}

.mini-grid-cell {
  background: rgba(13, 148, 136, 0.15);
  border-radius: 4rpx;
}

.mini-grid-cell.active {
  background: #3aafa9;
}

.mini-grid-cell.hot {
  background: #2b7a78;
}

.mini-grid-cell.super {
  background: #f59e0b;
}

.wheel-entry-main {
  flex: 1;
  min-width: 0;
}

.wheel-entry-kicker {
  color: var(--primary-color);
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  line-height: 1.2;
}

.wheel-entry-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.25;
  margin-top: 4rpx;
}

.wheel-entry-desc {
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 4rpx;
}

.wheel-entry-action {
  align-items: center;
  background: rgba(13, 148, 136, 0.08);
  border: 1rpx solid rgba(13, 148, 136, 0.2);
  border-radius: 24rpx;
  color: #0d9488;
  display: flex;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 750;
  height: 52rpx;
  justify-content: center;
  width: 96rpx;
}

.weekly-plan-card {
  overflow: hidden;
  border-radius: var(--radius-lg);
  padding: 0 !important;
}

.weekly-plan-row {
  align-items: center;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.weekly-plan-row + .weekly-plan-row {
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.weekly-plan-time {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(13, 148, 136, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.weekly-time-day {
  color: var(--primary-color);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.weekly-time-scene {
  color: #0f766e;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
  margin-top: 2rpx;
  opacity: 0.85;
}

.weekly-plan-body {
  flex: 1;
  min-width: 0;
}

.weekly-plan-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.weekly-plan-btn {
  align-items: center;
  background: rgba(13, 148, 136, 0.08);
  border-radius: 20rpx;
  color: #0d9488;
  border: 1rpx solid rgba(13, 148, 136, 0.2);
  display: flex;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  height: 54rpx;
  justify-content: center;
  width: 96rpx;
  padding: 0;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.weekly-plan-btn:active {
  opacity: 0.76;
  transform: scale(0.95);
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  position: relative;
}

.empty-card {
  padding: 36rpx;
}

.empty-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.empty-desc {
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.plan-card {
  display: flex;
  align-items: stretch;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  border-left: 8rpx solid var(--primary-color);
  margin-bottom: 0;
  box-sizing: border-box;
}

.plan-card.theme-0 {
  background: var(--trio-0-gradient);
  border-left-color: var(--trio-0-primary);
}

.plan-card.theme-1 {
  background: linear-gradient(135deg, #ffffff 0%, #F0FAF8 100%);
  border-left-color: rgba(58, 175, 169, 0.45);
}



.plan-card.risky {
  border-left-color: #e11d48 !important;
}

.plan-card.cancelled,
.plan-card.expired {
  border-left-color: #cbd5e1 !important;
  opacity: 0.75;
}

.plan-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-hover);
}

/* 左侧时间列：大字号、高对比度、清晰突出 */
.time-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  flex-shrink: 0;
  width: 150rpx;
  padding-right: 18rpx;
  border-right: 1rpx solid rgba(0, 0, 0, 0.05);
}

.plan-date-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: nowrap;
}

.plan-date-text {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.25;
  white-space: nowrap;
}

.plan-weekday-badge {
  color: #64748b;
  font-size: 20rpx;
  font-weight: 650;
  background: transparent;
  padding: 0;
  line-height: 1.2;
  white-space: nowrap;
}

.plan-time-main {
  color: #0f172a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
  margin-top: 6rpx;
  letter-spacing: -1rpx;
}

/* 右侧内容主体：3行结构 */
.plan-body {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 8rpx;
}

.plan-head {
  align-items: flex-start;
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.plan-title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.plan-status {
  border-radius: 8rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1;
  padding: 6rpx 12rpx;
}

.plan-status.confirmed {
  background: rgba(13, 148, 136, 0.08);
  color: #0d9488;
}

.plan-status.pending {
  background: rgba(217, 119, 6, 0.08);
  color: #d97706;
}

.plan-status.risky {
  background: rgba(225, 29, 72, 0.08);
  color: #e11d48;
}

.plan-status.completed {
  background: rgba(100, 116, 139, 0.08);
  color: #64748b;
}

.plan-status.cancelled,
.plan-status.expired {
  background: rgba(60, 60, 67, 0.04);
  color: var(--text-muted);
}

.plan-venue-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.3;
}

.venue-icon {
  font-size: 20rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

.venue-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部元数据栏与打卡按钮 */
.plan-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 4rpx;
}

.plan-meta-grid {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

/* 统一为优雅的 Slate 灰阶胶囊，彻底去除视觉噪音 */
.meta-slot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: rgba(15, 23, 42, 0.035);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  color: #475569;
  font-size: 21rpx;
  font-weight: 550;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  line-height: 1;
  box-sizing: border-box;
  white-space: nowrap;
  flex-shrink: 0;
}

.meta-slot.people {
  width: auto;
  min-width: 130rpx;
  max-width: 220rpx;
  flex-shrink: 0;
}

.meta-slot.commute {
  width: auto;
  min-width: 110rpx;
  flex-shrink: 0;
}

.meta-slot.warning {
  color: #b45309;
  background: rgba(245, 158, 11, 0.08);
  border-color: rgba(245, 158, 11, 0.2);
  font-weight: 650;
  padding: 0 12rpx;
  flex-shrink: 0;
}

.slot-emoji {
  font-size: 19rpx;
  flex-shrink: 0;
  opacity: 0.85;
}

.slot-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-risk {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #fef3c7;
  border-radius: 8rpx;
  color: #b45309;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.35;
  margin-top: 4rpx;
  padding: 6rpx 12rpx;
}

.risk-card {
  padding: 24rpx;
}

.risk-title {
  color: #b45309;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.risk-desc {
  color: var(--text-muted);
  font-size: 25rpx;
  line-height: 1.55;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-center {
  padding: 8rpx 24rpx;
}

.reminder-center-row {
  padding: 20rpx 0;
}

.reminder-center-row + .reminder-center-row {
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.reminder-center-title {
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.reminder-center-text {
  color: var(--text-muted);
  font-size: 23rpx;
  line-height: 1.45;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* iOS Muted Timeline styles */
.timeline-node-col {
  align-items: center;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  height: 100rpx;
  justify-content: center;
  position: relative;
  width: 40rpx;
}

.timeline-line {
  background: none;
  height: 200%;
  left: 50%;
  position: absolute;
  top: -50%;
  transform: translateX(-50%);
  width: 2rpx;
  z-index: 1;
}

.timeline-line::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  border-left: 2rpx solid rgba(58, 175, 169, 0.08);
}

/* Hide overlapping lines for extremities */
.timeline .plan-card:first-child .timeline-line {
  top: 50%;
  height: 150%;
}

.timeline .plan-card:last-child .timeline-line {
  height: 100%;
  top: -50%;
}

.timeline .plan-card:only-child .timeline-line {
  display: none;
}

.timeline-dot {
  --dot-color: #cbd5e1;
  background: var(--dot-color);
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(58, 175, 169, 0.08);
  height: 18rpx;
  position: relative;
  width: 18rpx;
  z-index: 2;
}

/* Color-coded simple dot nodes */
.timeline-dot.pending {
  --dot-color: var(--accent-color);
}

.timeline-dot.confirmed {
  --dot-color: var(--primary-color);
}

.timeline-dot.risky {
  --dot-color: #e25c5c;
}

.timeline-dot.completed {
  --dot-color: #0284c7;
}

.timeline-dot.cancelled,
.timeline-dot.expired {
  --dot-color: #cbd5e1;
}

/* --- Segmented Controls (Sleek & Compact) --- */
.segmented-control {
  align-items: center;
  display: flex;
  padding: 6rpx;
  background: rgba(58, 175, 169, 0.05);
  border-radius: 16rpx;
}

.segmented-item {
  flex: 1;
  text-align: center;
  align-items: center;
  border-radius: 12rpx;
  color: var(--text-secondary);
  display: flex;
  font-size: 23rpx;
  font-weight: 600;
  height: 54rpx;
  justify-content: center;
  line-height: 1.2;
  transition: var(--transition-normal);
}

.segmented-item.active {
  background: #ffffff;
  color: var(--primary-color);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  font-weight: 700;
}

.plan-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.quick-complete-btn {
  font-size: 21rpx;
  font-weight: 700;
  color: #15803d;
  background: rgba(34, 197, 94, 0.12);
  border: 1rpx solid rgba(34, 197, 94, 0.25);
  padding: 6rpx 16rpx;
  border-radius: 99rpx;
  line-height: 1;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.quick-complete-btn:active {
  background: #22c55e;
  color: #ffffff;
  transform: scale(0.95);
}
