.weekly-calendar-page {
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 28rpx;
}

/* Beautiful card style weekly date navigation bar */
.week-switcher-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(58, 175, 169, 0.04);
  border-radius: 16rpx;
  padding: 12rpx 20rpx 9rpx 20rpx; /* Mathematically compensated padding for narrow centering */
  margin-top: 24rpx;
  border: 1rpx solid rgba(58, 175, 169, 0.05);
}

/* Mini Weather Strip */
.week-weather-strip {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  background: rgba(58, 175, 169, 0.06);
  border-radius: 16rpx;
  padding: 12rpx 8rpx;
  margin-top: 14rpx;
  text-align: center;
}

.weather-strip-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 2rpx;
  border-radius: 10rpx;
}

.weather-strip-item.today {
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.strip-weekday {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 600;
}

.strip-icon {
  font-size: 24rpx;
  line-height: 1;
}

.strip-temp {
  font-size: 19rpx;
  color: #0f172a;
  font-weight: 700;
}

.switcher-controls-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.switcher-year {
  font-size: 22rpx; /* Enlarged for perfect readability */
  color: var(--text-muted);
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1; /* Fixed physical height matching font-size */
  margin-bottom: 1rpx; /* Mathematically compensated margin: 1rpx + 11rpx overshoot = 12rpx space */
}

.switcher-days {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 800;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

.arrow-btn-wrap {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.18s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.arrow-btn-wrap:active {
  background: rgba(58, 175, 169, 0.08); /* Sophisticated tap feedback */
}

.arrow-icon {
  font-size: 30rpx;
  color: var(--primary-color);
  font-weight: 800;
  line-height: 1;
}

.header-main-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title-col {
  display: flex;
  flex-direction: column;
}

.eyebrow {
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.page-title {
  font-size: 42rpx;
  font-weight: 900;
  color: var(--text-primary);
  letter-spacing: -0.5px;
  margin-top: 4rpx;
}

/* Premium Apple-style Segmented View Control */
.view-toggle {
  display: flex;
  background: rgba(58, 175, 169, 0.05);
  padding: 6rpx;
  border-radius: 100rpx;
  border: 1rpx solid rgba(58, 175, 169, 0.08);
}

.toggle-btn {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 800;
  padding: 10rpx 32rpx;
  border-radius: 100rpx;
  transition: all 0.24s cubic-bezier(0.25, 0.8, 0.25, 1);
  text-align: center;
}

.toggle-btn.active {
  background: #ffffff;
  color: var(--primary-color);
  box-shadow: 0 4rpx 12rpx rgba(58, 175, 169, 0.1);
}

/* ========================================================== */
/* 1. Timeline List View Styles                               */
/* ========================================================== */

.timeline-container {
  display: flex;
  flex-direction: column;
  position: relative;
  padding-left: 10rpx;
  margin-top: 24rpx;
}

.timeline-item {
  display: flex;
  flex-direction: row;
  position: relative;
  padding-bottom: 36rpx;
}

.timeline-item:last-child {
  padding-bottom: 10rpx;
}

/* Left Timeline Marker elements */
.timeline-marker {
  width: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex-shrink: 0;
}

.timeline-line {
  width: 2rpx;
  background: rgba(58, 175, 169, 0.1);
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-node {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 4rpx solid rgba(58, 175, 169, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 10rpx rgba(58, 175, 169, 0.03);
}

.timeline-node.node-today {
  border-color: var(--primary-color);
  background: var(--primary-color);
  box-shadow: 0 4rpx 12rpx rgba(58, 175, 169, 0.2);
}

.timeline-node.node-weekend {
  border-color: rgba(15, 118, 110, 0.4);
  background: #f0fdfa;
}

.node-date {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--text-secondary);
}

.timeline-node.node-today .node-date {
  color: #ffffff;
}

.timeline-item.weekend-start-row {
  margin-top: 20rpx;
  padding-top: 10rpx;
}

/* Right Content Area */
.timeline-body {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.day-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding-top: 4rpx;
}

.day-indicator.indicator-weekend {
  background: rgba(15, 118, 110, 0.04);
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  display: inline-flex;
  align-self: flex-start;
}

.day-month-lbl {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 700;
}

.day-weekday-lbl {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 800;
}

.day-weekday-lbl.weekend {
  color: #0f766e;
}

.weekend-pill-tag {
  font-size: 16rpx;
  background: #0f766e;
  color: #ffffff;
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
  font-weight: 800;
  line-height: 1.2;
}

.timeline-item.is-today .day-weekday-lbl {
  color: var(--primary-color);
}

/* Schedule Card elements (1 border level, no nested double border box) */
.schedule-card {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: 28rpx;
  border: 1rpx solid rgba(58, 175, 169, 0.05);
  box-shadow: var(--shadow-soft);
  position: relative;
  overflow: hidden;
  transition: var(--transition-normal);
  margin-bottom: 14rpx;
  border-left: 6rpx solid transparent;
}

.schedule-card:last-child {
  margin-bottom: 0;
}

.schedule-card:active {
  transform: scale(0.985);
  box-shadow: var(--shadow-hover);
}

.schedule-card.planned {
  border-left-color: var(--primary-color);
}

.schedule-card.recommended {
  border-left-color: var(--accent-color);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-scene {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--text-secondary);
  background: rgba(0, 0, 0, 0.03);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.card-badge {
  font-size: 20rpx;
  font-weight: 800;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.badge-planned {
  color: var(--primary-color);
  background: var(--primary-light);
}

.badge-recommended {
  color: var(--accent-color);
  background: var(--accent-light);
}

.card-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.card-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.meta-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f4f7f6;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-label {
  font-size: 18rpx;
  color: var(--text-muted);
  font-weight: 700;
}

.tag-value {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 800;
}

.card-reason {
  background: rgba(217, 156, 82, 0.05);
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-top: 4rpx;
}

.reason-title {
  font-size: 20rpx;
  color: var(--accent-color);
  font-weight: 800;
  flex-shrink: 0;
}

.reason-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 600;
  line-height: 1.4;
}

/* Empty node placeholder card */
.empty-agenda {
  background: #ffffff;
  border: 1rpx dashed rgba(58, 175, 169, 0.12);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: var(--transition-normal);
}

.empty-agenda:active {
  background: rgba(58, 175, 169, 0.03);
  border-color: rgba(58, 175, 169, 0.25);
}

.empty-agenda-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.empty-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: bold;
}

.empty-sub {
  font-size: 20rpx;
  color: var(--text-muted);
}

.empty-arrow {
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: 800;
  background: var(--primary-light);
  padding: 6rpx 18rpx;
  border-radius: 50rpx;
  border: 1rpx solid rgba(58, 175, 169, 0.08);
}

/* ========================================================== */
/* 2. Ribbon + Day Agenda & Suggestions View Styles            */
/* ========================================================== */

.calendar-ribbon-container {
  background: #ffffff;
  padding: 16rpx 8rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-soft);
  border: 1rpx solid rgba(58, 175, 169, 0.04);
  margin-bottom: 24rpx;
  box-sizing: border-box;
  position: relative; /* Enabled for today floating button positioning */
}

/* Float Today button at bottom-right corner */
.today-float-btn {
  position: absolute;
  right: 14rpx;
  bottom: -18rpx;
  width: 52rpx;
  height: 52rpx;
  background: var(--primary-color);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(58, 175, 169, 0.25);
  z-index: 10;
  transition: transform 0.15s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.today-float-btn:active {
  transform: scale(0.88);
}

.calendar-ribbon {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
}

.ribbon-row {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  width: 100%;
  gap: 4rpx;
}

.ribbon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  flex: 1;
  min-width: 0;
  height: auto;
  min-height: 110rpx;
  padding: 12rpx 2rpx 16rpx;
  border-radius: 14rpx;
  transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
  position: relative;
  box-sizing: border-box;
}

.ribbon-item.is-weekend:not(.active) {
  background: rgba(15, 118, 110, 0.05);
}

.ribbon-item.weekend-start {
  position: relative;
  border-left: 1rpx dashed rgba(15, 118, 110, 0.25);
}

.ribbon-item.is-weekend:not(.active) .ribbon-weekday {
  color: #0f766e;
  font-weight: 850;
}

.weekend-tag-tiny {
  font-size: 13rpx;
  background: #0f766e;
  color: #ffffff;
  padding: 0 3rpx;
  border-radius: 4rpx;
  margin-left: 2rpx;
  font-weight: 800;
  line-height: 1.2;
}

.ribbon-item.active {
  background: var(--primary-color);
  box-shadow: 0 6rpx 16rpx rgba(58, 175, 169, 0.16);
  transform: scale(1.02);
}

.ribbon-weekday {
  font-size: 17rpx;
  color: var(--text-muted);
  font-weight: 800;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ribbon-item.active .ribbon-weekday {
  color: rgba(255, 255, 255, 0.8);
}

.ribbon-date-num {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin: 4rpx auto;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.ribbon-item.active .ribbon-date-num {
  color: #ffffff;
}

/* Today is NOT selected: show green text and a light round background */
.ribbon-item.today:not(.active) .ribbon-date-num {
  background: rgba(58, 175, 169, 0.1);
  color: var(--primary-color);
  font-weight: 900;
}

/* Today IS selected: show white background with green text */
.ribbon-item.today.active .ribbon-date-num {
  background: #ffffff;
  color: var(--primary-color);
  font-weight: 900;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* Brief summary label instead of tiny dots */
.ribbon-brief-badge {
  font-size: 15rpx;
  font-weight: 750;
  padding: 2rpx 4rpx;
  border-radius: 6rpx;
  margin-top: 6rpx;
  text-align: center;
  max-width: 96%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ribbon-brief-badge.planned {
  background: var(--primary-light);
  color: var(--primary-color);
}

.ribbon-brief-badge.recommended {
  background: var(--accent-light);
  color: var(--accent-color);
}

/* Active ribbon item: high contrast white semi-translucent styling */
.ribbon-item.active .ribbon-brief-badge.planned,
.ribbon-item.active .ribbon-brief-badge.recommended {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

.ribbon-brief-empty {
  font-size: 18rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  font-weight: 800;
}

.ribbon-item.active .ribbon-brief-empty {
  color: rgba(255, 255, 255, 0.6);
}


/* Agenda detail panel */
.agenda-detail-panel {
  background: transparent;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.agenda-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
  margin-bottom: 4rpx;
}

.agenda-header-title {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.agenda-header-status {
  font-size: 20rpx;
  color: #ffffff;
  background: var(--primary-color);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 800;
  box-shadow: 0 2rpx 6rpx rgba(58, 175, 169, 0.15);
}

.agenda-arrangements {
  display: flex;
  flex-direction: column;
}

/* Agenda empty state card */
.agenda-empty-card {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid rgba(58, 175, 169, 0.04);
  box-shadow: var(--shadow-soft);
}

.agenda-empty-icon {
  font-size: 48rpx;
  background: #f4f7f6;
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(58, 175, 169, 0.03);
}

.agenda-empty-text-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.agenda-empty-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 800;
}

.agenda-empty-sub {
  font-size: 20rpx;
  color: var(--text-muted);
  line-height: 1.3;
}

/* Agenda suggestions block */
.agenda-suggestions {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestions-header {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.suggestions-header-title {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.suggestions-header-desc {
  font-size: 18rpx;
  color: var(--text-muted);
  font-weight: bold;
}

.suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  background: #ffffff;
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid rgba(58, 175, 169, 0.04);
  box-shadow: var(--shadow-soft);
  transition: var(--transition-normal);
}

.suggestion-item:active {
  transform: scale(0.985);
  box-shadow: var(--shadow-hover);
}

.suggestion-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  padding-right: 20rpx;
}

.suggestion-badge-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.suggestion-scene {
  font-size: 18rpx;
  color: var(--text-secondary);
  background: rgba(0, 0, 0, 0.03);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-weight: 800;
}

.suggestion-score {
  font-size: 18rpx;
  color: var(--accent-color);
  background: var(--accent-light);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-weight: 800;
}

.suggestion-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.suggestion-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.suggestion-meta-text {
  font-size: 18rpx;
  color: var(--text-muted);
  font-weight: bold;
}

.suggestion-meta-divider {
  font-size: 18rpx;
  color: rgba(0, 0, 0, 0.06);
}

.suggestion-action-btn {
  font-size: 22rpx;
  color: #ffffff;
  background: var(--primary-color);
  font-weight: 700;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  transition: var(--transition-normal);
}

.suggestion-action-btn:active {
  transform: scale(0.94);
}

/* Weather Badges & Agenda Weather Bar */
.day-weather-lbl {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 600;
  background: rgba(58, 175, 169, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 6rpx;
}

.ribbon-weather-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: rgba(0, 0, 0, 0.04);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  margin: 4rpx 0 6rpx;
  transition: all 0.2s ease;
}

.ribbon-weather-badge.rain {
  background: rgba(59, 130, 246, 0.1);
}

.ribbon-item.active .ribbon-weather-badge {
  background: rgba(255, 255, 255, 0.22);
}

.ribbon-weather-icon {
  font-size: 18rpx;
  line-height: 1;
}

.ribbon-weather-temp {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.ribbon-item.active .ribbon-weather-temp {
  color: #ffffff;
}

.agenda-weather-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(58, 175, 169, 0.06), rgba(43, 122, 120, 0.03));
  border: 1rpx solid rgba(58, 175, 169, 0.12);
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
}

.agenda-weather-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.agenda-weather-icon {
  font-size: 38rpx;
  line-height: 1;
}

.agenda-weather-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.agenda-weather-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.agenda-weather-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.agenda-weather-tips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-top: 6rpx;
  border-top: 1rpx dashed rgba(58, 175, 169, 0.1);
}

.agenda-weather-chip {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--primary-color);
  background: rgba(58, 175, 169, 0.08);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
