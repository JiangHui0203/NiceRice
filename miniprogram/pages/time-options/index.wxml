<view class="page time-page" wx:if="{{plan || coupon}}">
  <view class="page-header">
    <view class="eyebrow">{{plan ? (isRecipient ? '📨 正在向朋友发起协商改期' : '重新选择后，有朋友参与会回到待确认') : '先挑选合适时间，再确认参与人和安排'}}</view>
    <view class="page-title">{{plan ? (isRecipient ? '提议新时间' : '选择新时间') : '为这张券选择时间'}}</view>
    <view class="page-subtitle" wx:if="{{plan}}">当前计划：{{plan.selectedTime.label || plan.date}} {{plan.selectedTime.startTime || plan.time}}</view>
    <view class="page-subtitle" wx:else>待安排：{{coupon.title}}</view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">推荐可选时间</view>
    </view>
    <view class="option-list">
      <view
        wx:for="{{options}}"
        wx:key="optionId"
        class="time-card card {{selectedIndex === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="selectOption"
      >
        <view class="time-card-header">
          <view class="time-card-left">
            <view class="time-badge {{index === 0 ? 'primary' : index === 1 ? 'secondary' : 'neutral'}}">{{item.label}}</view>
            <view class="time-title">{{item.weekday}} {{item.startTime}}</view>
            <view class="time-weather-pill" wx:if="{{item.weatherTag}}">{{item.weatherTag}}</view>
            <view class="time-weather-badge {{item.weatherBadge.theme}}" wx:if="{{item.weatherBadge}}">{{item.weatherBadge.label}}</view>
          </view>
          <view class="time-score-box">
            <text class="time-score-num">{{item.score}}</text>
            <text class="time-score-percent">%</text>
            <text class="time-score-label">适合</text>
          </view>
        </view>
        
        <view class="time-card-body">
          <view class="time-card-desc">{{item.desc}}</view>
          <view class="time-card-range">计划时段：{{item.range}}</view>
        </view>
        
        <!-- Conflict warning tag if overlapping with other plan -->
        <view class="time-card-conflict" wx:if="{{item.hasConflict}}" style="margin-top: 10rpx; font-size: 22rpx; color: #d97706; background: rgba(245, 158, 11, 0.08); padding: 8rpx 14rpx; border-radius: 8rpx; display: inline-flex; align-items: center; gap: 6rpx;">
          <text>⚠️ 与已有日程【{{item.conflictTitle}}】同一天</text>
        </view>

        <view class="time-card-warnings" wx:if="{{item.warnings && item.warnings.length}}">
          <view class="warning-item" wx:for="{{item.warnings}}" wx:for-item="warn" wx:key="*this" catchtap="showNoticeDetail" data-text="{{warn}}">
            <text class="warning-icon">⚠️</text>
            <text class="warning-text">{{warn}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Custom Time Section -->
  <view class="section">
    <view class="custom-time-toggle card" bindtap="toggleCustom" style="display: flex; justify-content: space-between; align-items: center; padding: 24rpx 30rpx; margin-top: 24rpx; background: #ffffff; border-radius: var(--radius-md); border: 1rpx solid var(--border-color);">
      <view style="font-size: 28rpx; font-weight: 700; color: var(--text-primary);">自定义时间</view>
      <view style="font-size: 26rpx; color: var(--primary-color);">{{showCustom ? '收起' : '展开选择 🗓️'}}</view>
    </view>

    <view wx:if="{{showCustom}}" class="custom-picker-box card" style="margin-top: 16rpx; padding: 30rpx; background: #ffffff; border-radius: var(--radius-md); border: 1rpx solid var(--border-color);">
      <view style="display: flex; gap: 20rpx; margin-bottom: 24rpx;">
        <picker mode="date" value="{{customDate}}" bindchange="onCustomDateChange" style="flex: 1;">
          <view style="padding: 20rpx; border: 1rpx solid var(--border-color); border-radius: 12rpx; text-align: center; font-size: 26rpx;">
            <view style="color: var(--text-muted); font-size: 20rpx; margin-bottom: 4rpx;">选择日期</view>
            <view style="font-weight: 700; color: var(--text-primary);">{{customDate}}</view>
          </view>
        </picker>
        <picker mode="time" value="{{customTime}}" bindchange="onCustomTimeChange" style="flex: 1;">
          <view style="padding: 20rpx; border: 1rpx solid var(--border-color); border-radius: 12rpx; text-align: center; font-size: 26rpx;">
            <view style="color: var(--text-muted); font-size: 20rpx; margin-bottom: 4rpx;">选择时间</view>
            <view style="font-weight: 700; color: var(--text-primary);">{{customTime}}</view>
          </view>
        </picker>
      </view>
      <view style="font-size: 22rpx; color: var(--text-muted); text-align: center;">选择后将自动评估该时间段的适合度及合理性</view>
    </view>
  </view>

  <view wx:if="{{!options.length}}" class="empty-card card">
    <view class="empty-title">暂无合适备选时间</view>
    <view class="empty-desc">可以先保留原计划，或回到券详情重新安排。</view>
  </view>

  <view class="bottom-actions">
    <button class="btn btn-primary" bindtap="confirmChange" disabled="{{!selectedOption || submitting}}">{{submitting ? '处理中…' : (plan ? (isRecipient ? '📨 提议改为该时间' : '✓ 就定这个时间') : '继续确认安排')}}</button>
  </view>
</view>
